# Resend — e-mailbezorging van het contactformulier
# Maak een sleutel aan op https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Afzenderadres. Moet op een domein staan dat je in Resend hebt geverifieerd.
# Voor snel testen kun je gebruiken: HubIzi <onboarding@resend.dev>
RESEND_FROM="HubIzi Schilderwerken <noreply@hubizi-schilderwerken.nl>"

# Waar contactaanvragen naartoe worden gestuurd (standaard het site-e-mailadres).
RESEND_TO=info@hubizi-schilderwerken.nl
