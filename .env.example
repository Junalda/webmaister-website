# Resend — contact form email delivery
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Must be on a domain you have verified in Resend.
# For quick testing you can use: Webmaister <onboarding@resend.dev>
RESEND_FROM="Webmaister <noreply@webmaister.io>"

# Where contact submissions are delivered (defaults to the site email).
RESEND_TO=hello@webmaister.io

# ---------------------------------------------------------------------------
# Blog auto-publishing (GetAutoSEO / Zapier -> /api/blog/ingest)
# Only needed if you publish posts through the webhook endpoint.
# ---------------------------------------------------------------------------
# Shared secret the publisher must send as `Authorization: Bearer <token>`.
BLOG_INGEST_TOKEN=choose-a-long-random-secret
# GitHub Personal Access Token with write access to this repo's contents.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
# Optional overrides (defaults shown):
GITHUB_REPO=junalda/webmaister-website
GITHUB_BRANCH=main
