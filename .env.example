# Resend — contact form email delivery
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Must be on a domain you have verified in Resend.
# For quick testing you can use: Webmaister <onboarding@resend.dev>
RESEND_FROM="Webmaister <noreply@webmaister.io>"

# Where contact submissions are delivered (defaults to the site email).
RESEND_TO=hello@webmaister.io

# Cloudflare Turnstile (optional). Create a free Managed widget for
# webmaister.io and www.webmaister.io in the Cloudflare dashboard:
# https://dash.cloudflare.com/?to=/:account/turnstile
# When BOTH keys are set, /api/contact requires a valid token.
# When either key is missing, Turnstile is skipped (honeypot + timing stay on).
# The public site key is baked into the pages at build time, so redeploy
# after adding these in Vercel.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# AutoSEO blog auto-publishing (getautoseo.com -> /api/autoseo)
# ---------------------------------------------------------------------------
# Webhook Bearer token (also used as the HMAC-SHA256 secret). Required: the
# endpoint returns 500 if this is unset. Must match the token configured in
# AutoSEO. Rotate if it leaks.
AUTOSEO_WEBHOOK_TOKEN=aseo_wh_06e2e1e031ab6724fb0b06f706745b51
# GitHub Personal Access Token with write access to this repo's contents
# (the webhook commits the post + images, which triggers a Vercel redeploy).
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
# Optional overrides (defaults shown):
GITHUB_REPO=junalda/webmaister-website
GITHUB_BRANCH=main
