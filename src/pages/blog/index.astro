---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import FilterBar from "@/components/FilterBar.astro";
import { site } from "@/data/site";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

// Unique tags across posts → filter pills. Labels are title-cased for a
// consistent look; values are lowercased to match each card's data attribute.
const titleCase = (s: string) => s.replace(/\b\w/g, (c) => c.toUpperCase());
const tagFilters = [...new Set(posts.flatMap((p) => p.data.tags))]
  .sort((a, b) => a.localeCompare(b))
  .map((t) => ({ label: titleCase(t), value: t.toLowerCase() }));

// Blog collection schema so AI/search engines see this as the article hub.
const blogLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${site.url}/blog/#blog`,
  name: `${site.name} Blog`,
  url: `${site.url}/blog/`,
  description:
    "Insights on premium websites, SEO, growth systems and AI automation from Webmaister.",
  publisher: { "@id": `${site.url}/#organization` },
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    description: p.data.description,
    url: `${site.url}/blog/${p.data.slug ?? p.id}/`,
    datePublished: p.data.pubDate.toISOString(),
  })),
};
---
<Base
  title="Blog · Growth, SEO & AI Insights"
  description="Insights on premium websites, SEO, growth systems and AI automation from Webmaister, your Growth & AI Infrastructure Partner in Rotterdam."
>
  <section class="page-hero">
    <div class="container center" style="max-width:780px">
      <span class="eyebrow" data-reveal>Blog</span>
      <h1 data-reveal data-delay="60">Ideas for businesses<br><span class="gradient-text">built to grow.</span></h1>
      <p class="lead" data-reveal data-delay="120" style="margin:1.4rem auto 0;max-width:600px">
        Practical thinking on premium websites, SEO, growth systems and AI automation,
        from the team behind Webmaister.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {posts.length === 0 ? (
        <p class="center" style="color:var(--text-muted)">New articles are on the way. Check back soon.</p>
      ) : (
        <>
          {tagFilters.length > 1 && <FilterBar filters={tagFilters} scope="tag" allLabel="All topics" label="Filter articles by topic" />}
          <p class="filter-empty center" data-filter-empty="tag" hidden style="color:var(--text-muted)">No articles in this topic yet.</p>
          <div class="posts grid grid-3">
          {posts.map((post, i) => (
            <a href={`/blog/${post.data.slug ?? post.id}/`} class="post-card card card-hover" data-reveal data-delay={i * 70} data-filter-group="tag" data-filter-values={post.data.tags.map((t) => t.toLowerCase()).join("|")}>
              {post.data.cover && (
                <div class="post-cover"><img src={post.data.cover} alt={post.data.heroAlt ?? ""} loading="lazy" decoding="async" /></div>
              )}
              <div class="post-body">
                <div class="post-meta">
                  <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                  {post.data.tags[0] && <span class="post-tag">{post.data.tags[0]}</span>}
                </div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <span class="post-link">Read article <Icon name="arrow" /></span>
              </div>
            </a>
          ))}
          </div>
        </>
      )}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(blogLd)} is:inline />
</Base>

<style>
  .page-hero { padding-block: clamp(60px, 9vw, 120px) clamp(40px, 6vw, 64px); background: var(--grad-soft); border-bottom: 1px solid var(--line); }
  .posts { align-items: stretch; }
  .post-card { display: flex; flex-direction: column; padding: 0; overflow: hidden; }
  .post-cover { aspect-ratio: 16 / 9; overflow: hidden; background: var(--bg-alt); }
  .post-cover img { width: 100%; height: 100%; object-fit: cover; }
  .post-body { display: flex; flex-direction: column; flex: 1; padding: clamp(1.3rem, 2.5vw, 1.7rem); }
  .post-meta { display: flex; align-items: center; gap: 0.7rem; font-size: 0.8rem; color: var(--text-faint); margin-bottom: 0.7rem; }
  .post-tag { color: var(--brand-strong); font-weight: 600; }
  .post-card h2 { font-size: 1.3rem; line-height: 1.25; margin-bottom: 0.6rem; }
  .post-card p { flex: 1; font-size: 0.97rem; line-height: 1.55; }
  .post-link { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 1.2rem; color: var(--brand); font-weight: 580; font-size: 0.93rem; }
  .post-link :global(svg) { width: 16px; height: 16px; transition: transform 0.2s ease; }
  .post-card:hover .post-link :global(svg) { transform: translateX(4px); }
</style>
