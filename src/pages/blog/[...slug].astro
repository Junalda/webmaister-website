---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import FinalCta from "@/components/FinalCta.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import { site } from "@/data/site";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug ?? post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, author, tags, cover, heroAlt, faq } = post.data;
const routeSlug = post.data.slug ?? post.id;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const canonical = new URL(`/blog/${routeSlug}/`, site.url).href;

const graph: object[] = [
  {
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: { "@type": "Organization", name: author, url: site.url },
    publisher: { "@id": `${site.url}/#organization` },
    mainEntityOfPage: canonical,
    url: canonical,
    ...(cover ? { image: new URL(cover, site.url).href } : {}),
    ...(tags.length ? { keywords: tags.join(", ") } : {}),
  },
];
if (faq && faq.length) {
  graph.push({
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer },
    })),
  });
}
const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---
<Base title={`${title} · ${site.name} Blog`} description={description}>
  <article class="post">
    <div class="container container-narrow">
      <a href="/blog/" class="back-link" data-reveal><Icon name="arrow" class="flip" /> All articles</a>

      <header class="post-head" data-reveal>
        <div class="post-meta">
          <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
          {tags.map((t) => <span class="post-tag">{t}</span>)}
        </div>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        <p class="post-byline">By {author}</p>
        <ShareButtons url={canonical} title={title} />
      </header>

      {cover && <img class="post-hero-img" src={cover} alt={heroAlt ?? ""} data-reveal />}

      <div class="prose" data-reveal>
        <Content />
      </div>

      {faq && faq.length > 0 && (
        <section class="post-faq" data-reveal>
          <h2>Frequently asked questions</h2>
          {faq.map((f) => (
            <details class="faq-item">
              <summary>{f.question}</summary>
              <div class="faq-answer"><p>{f.answer}</p></div>
            </details>
          ))}
        </section>
      )}

      <div class="post-share-bottom">
        <ShareButtons url={canonical} title={title} label="Vond je dit waardevol? Deel het" />
      </div>
    </div>
  </article>

  <FinalCta
    title="Ready to build a business<br>that scales?"
    text="Book a free Growth Strategy Call and we'll map a clear path to the digital foundation your business needs to grow."
  />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>

<style>
  .post { padding-block: clamp(48px, 7vw, 90px) clamp(40px, 6vw, 70px); }
  .back-link { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.92rem; font-weight: 540; color: var(--text-muted); margin-bottom: 2rem; }
  .back-link:hover { color: var(--brand); }
  .back-link :global(.flip) { width: 16px; height: 16px; transform: rotate(180deg); }

  .post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem; font-size: 0.85rem; color: var(--text-faint); margin-bottom: 1rem; }
  .post-tag { color: var(--brand-strong); font-weight: 600; }
  .post-head h1 { font-size: clamp(2rem, 4.5vw, 3.1rem); letter-spacing: -0.03em; }
  .post-head .lead { margin-top: 1.1rem; }
  .post-byline { margin-top: 1.1rem; font-size: 0.9rem; color: var(--text-faint); }
  .post-head :global(.share) { margin-top: 1.6rem; padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .post-share-bottom { margin-top: clamp(2.5rem, 5vw, 3.5rem); padding-top: 1.6rem; border-top: 1px solid var(--line); }

  .post-hero-img { width: 100%; border-radius: var(--r-lg); margin: clamp(2rem, 4vw, 3rem) 0 0; border: 1px solid var(--line); }

  /* Article prose */
  .prose { margin-top: clamp(2rem, 4vw, 3rem); }
  .prose :global(h2) { font-size: clamp(1.4rem, 3vw, 1.9rem); letter-spacing: -0.02em; margin: 2.4rem 0 0.9rem; }
  .prose :global(h3) { font-size: clamp(1.15rem, 2.2vw, 1.4rem); margin: 1.8rem 0 0.7rem; }
  .prose :global(p) { font-size: 1.08rem; line-height: 1.75; color: var(--text); margin-bottom: 1.2rem; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.4rem; padding-left: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .prose :global(ul li) { position: relative; padding-left: 1.6rem; line-height: 1.7; color: var(--text); }
  .prose :global(ul li)::before { content: ""; position: absolute; left: 0; top: 0.65em; width: 7px; height: 7px; border-radius: 50%; background: var(--grad-brand); }
  .prose :global(ol) { counter-reset: li; }
  .prose :global(ol li) { position: relative; padding-left: 1.8rem; counter-increment: li; line-height: 1.7; }
  .prose :global(ol li)::before { content: counter(li); position: absolute; left: 0; top: 0; font-weight: 700; color: var(--brand); font-size: 0.95rem; }
  .prose :global(strong) { font-weight: 650; color: var(--ink); }
  .prose :global(a) { color: var(--brand); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(blockquote) { margin: 1.6rem 0; padding: 1rem 1.4rem; border-left: 3px solid var(--brand); background: var(--bg-alt); border-radius: 0 var(--r-md) var(--r-md) 0; font-size: 1.1rem; }
  .prose :global(img) { width: 100%; border-radius: var(--r-md); margin: 1.6rem 0; }
  .prose :global(code) { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9em; background: var(--bg-alt); padding: 0.15em 0.4em; border-radius: 6px; }
  .prose :global(hr) { border: none; border-top: 1px solid var(--line); margin: 2.4rem 0; }

  /* FAQ */
  .post-faq { margin-top: clamp(2.5rem, 5vw, 3.5rem); }
  .post-faq h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); margin-bottom: 1.2rem; }
  .post-faq .faq-item { border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); margin-bottom: 0.7rem; overflow: hidden; }
  .post-faq summary { padding: 1.05rem 1.3rem; font-weight: 580; cursor: pointer; list-style: none; }
  .post-faq summary::-webkit-details-marker { display: none; }
  .post-faq .faq-answer { padding: 0 1.3rem 1.2rem; }
  .post-faq .faq-answer p { color: var(--text-muted); }
</style>
