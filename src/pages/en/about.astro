---
import Base from "@/layouts/Base.astro";
import FinalCta from "@/components/FinalCta.astro";
import { site, core, caseStudies } from "@/data/site";
import { alternatesFor } from "@/i18n";

const facts = [
  { label: "Founded", value: site.founded },
  { label: "Based at", value: `${site.streetAddress}, ${site.postalCode} ${site.city}` },
  { label: "KvK", value: site.kvk },
  { label: "Serves", value: site.areaServed.join(" · ") },
];
---
<Base
  title="About Webmaister · Junalda Meiland, founder"
  description={core.en}
  lang="en"
  alternates={alternatesFor("/over-ons/", "/en/about/")}
>
  <section class="page-hero">
    <div class="container center" style="max-width:820px">
      <span class="eyebrow" data-reveal>About Webmaister</span>
      <h1 data-reveal data-delay="60">Websites that get found<br><span class="gradient-text">on Google and in AI.</span></h1>
      <p class="lead" data-reveal data-delay="120" style="margin:1.4rem auto 0;max-width:640px">{core.en}</p>
    </div>
  </section>

  <section class="section">
    <div class="container founder-grid">
      <figure class="founder-photo" data-reveal>
        <img src="/junalda.jpg" alt="Junalda Meiland, founder of Webmaister" width="1717" height="2576" />
      </figure>
      <div class="founder-copy" data-reveal>
        <span class="eyebrow">Founder</span>
        <h2>Junalda Meiland, founder</h2>
        <p>Junalda Meiland has 10+ years in technology, a background in software development and IT project management, and has been an entrepreneur since 2016. She is based in Rotterdam.</p>
        <p>Her approach: start from where the business wants to go, then build the website, the findability and the automation.</p>
        <p><a class="founder-link" href={site.social.founderLinkedin} target="_blank" rel="noopener noreferrer">Junalda Meiland on LinkedIn</a></p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container container-narrow about-intro" data-reveal>
      <h2>Why Webmaister exists</h2>
      <p>{core.en}</p>
      <p>A site that looks finished but cannot be found does not take the business where it wants to go. Webmaister builds the website, findability on Google and in AI assistants like ChatGPT, and automation for support, bookings, follow-ups and admin as one piece of work.</p>
      <h2>How we work</h2>
      <p>A One-Pager is live within 7 days. After that we maintain the site. The monthly fee covers maintenance and, on Growth Essentials, findability on Google and in AI. We build custom, code-based sites. We do not build WordPress sites.</p>
      <h2>Who it is for</h2>
      <p>Entrepreneurs and SMEs. We are based in Rotterdam and work across Rotterdam, Zuid-Holland and the rest of the Netherlands, including remotely.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">At a glance</span>
        <h2>The facts</h2>
      </div>
      <ul class="facts grid grid-4" data-reveal>
        {facts.map((f) => (
          <li class="fact card">
            <span class="fact-label">{f.label}</span>
            <span class="fact-value">{f.value}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Work</span>
        <h2>Cases</h2>
      </div>
      <ul class="case-links" data-reveal>
        {caseStudies.map((cs) => (
          <li><a href={`/en/work/#${cs.slug}`}>Read the {cs.company} case</a></li>
        ))}
      </ul>
      <p class="case-more" data-reveal><a href="/en/work/">All Webmaister cases</a> · <a href="/en/contact/">Contact Webmaister</a></p>
    </div>
  </section>

  <FinalCta
    title="See packages<br>and prices."
    text="One-Pager €500 setup + €150 per month, live within 7 days. Growth Essentials €2,700 setup + €300 per month. Growth Partnership is price on request."
    eyebrow="Start"
    ctaHref="/start/"
    ctaLabel="See packages and prices"
    secondaryHref="/en/solutions/"
    secondaryLabel="See our services"
  />
</Base>

<style>
  .page-hero { padding-block: clamp(60px, 9vw, 120px) clamp(40px, 6vw, 70px); background: var(--grad-soft); border-bottom: 1px solid var(--line); }
  .founder-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(1.6rem, 4vw, 3.5rem); align-items: center; }
  .founder-photo { margin: 0; }
  .founder-photo img { width: 100%; height: auto; border-radius: var(--r-lg); object-fit: cover; max-height: 640px; }
  .founder-copy h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0.4rem 0 1rem; }
  .founder-copy p { font-size: clamp(1.05rem, 2vw, 1.2rem); line-height: 1.65; color: var(--text); }
  .founder-copy p + p { margin-top: 1rem; }
  .founder-link { font-weight: 600; color: var(--brand-strong); }
  .about-intro h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin: 2rem 0 0.8rem; }
  .about-intro h2:first-child { margin-top: 0; }
  .about-intro p { font-size: clamp(1.1rem, 2vw, 1.3rem); line-height: 1.65; color: var(--text); }
  .about-intro p + p { margin-top: 1.3rem; }
  .facts { margin-top: 3rem; }
  .fact { display: flex; flex-direction: column; gap: 0.35rem; text-align: center; }
  .fact-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--brand-strong); }
  .fact-value { font-size: 1.05rem; font-weight: 650; color: var(--ink); }
  .case-links { display: grid; gap: 0.8rem; max-width: 640px; margin: 2rem auto 0; }
  .case-links a, .case-more a { font-weight: 600; color: var(--brand-strong); }
  .case-more { text-align: center; margin-top: 1.6rem; color: var(--text-muted); }
  @media (max-width: 800px) {
    .founder-grid { grid-template-columns: 1fr; }
    .founder-photo img { max-height: 480px; }
  }
</style>
