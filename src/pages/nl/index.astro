---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import Button from "@/components/Button.astro";
import { site } from "@/data/site";
import { services } from "@/data/services";

const title = "Diensten in Rotterdam · Webdesign, SEO & AI-automatisering";
const description =
  "Webmaister helpt ambitieuze ondernemers in Rotterdam groeien: premium websites, SEO en AI-automatisering. Bekijk onze diensten en plan een gratis strategiegesprek.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Diensten in Rotterdam",
  description,
  url: `${site.url}/nl/`,
  isPartOf: { "@id": `${site.url}/#website` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: services.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: p.keyword,
      url: `${site.url}/nl/${p.slug}/`,
    })),
  },
};
---
<Base lang="nl" title={title} description={description}>
  <section class="page-hero">
    <div class="container center" style="max-width:820px">
      <span class="eyebrow" data-reveal>Rotterdam</span>
      <h1 data-reveal data-delay="60">Jouw groeipartner in Rotterdam</h1>
      <p class="lead" data-reveal data-delay="120" style="margin:1.4rem auto 0;max-width:640px">
        Premium websites, vindbaarheid in Google en AI-automatisering, alles om meer klanten aan te trekken en meer tijd over te houden.
      </p>
      <div class="hero-cta" data-reveal data-delay="180">
        <Button href="/contact/" variant="brand" size="lg" arrow>Plan een gratis gesprek</Button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Onze diensten</span>
        <h2>Waarmee we je helpen groeien</h2>
      </div>
      <a class="nl-featured card" href="/nl/acquisitiesysteem/" data-reveal>
        <span class="nl-featured-tag">Onze kernaanpak</span>
        <h3>Een acquisitiesysteem: website, positionering en leadgeneratie als één geheel</h3>
        <p>Geen losse onderdelen, maar één systeem dat structureel de juiste klanten aantrekt.</p>
        <span class="nl-card-link">Ontdek het acquisitiesysteem <Icon name="arrow" /></span>
      </a>
      <div class="nl-grid">
        {services.map((p) => (
          <a class="nl-card card" href={`/nl/${p.slug}/`} data-reveal>
            <h3>{p.keyword}</h3>
            <p>{p.lead}</p>
            <span class="nl-card-link">Lees meer <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container center" style="max-width:680px">
      <h2 data-reveal>Klaar om te groeien in Rotterdam?</h2>
      <p class="lead" data-reveal style="margin:1rem auto 1.8rem">Plan een gratis strategiegesprek. We bekijken je situatie en maken een helder plan om meer klanten aan te trekken.</p>
      <Button href="/contact/" variant="brand" size="lg" arrow>Plan een gratis gesprek</Button>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>

<style>
  .page-hero { padding-block: clamp(60px, 9vw, 120px) clamp(48px, 6vw, 80px); background: var(--grad-soft); border-bottom: 1px solid var(--line); }
  .hero-cta { margin-top: 2rem; }
  .nl-featured { display: block; margin-top: 2.5rem; text-decoration: none; color: inherit; border-color: rgba(10,142,242,0.28); background: var(--bg-tint); transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .nl-featured:hover { transform: translateY(-3px); border-color: var(--brand); box-shadow: var(--shadow-md); }
  .nl-featured-tag { display: inline-block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--brand-strong); margin-bottom: 0.6rem; }
  .nl-featured h3 { font-size: clamp(1.2rem, 2.4vw, 1.5rem); margin-bottom: 0.5rem; max-width: 30ch; }
  .nl-featured p { color: var(--text-muted); margin-bottom: 0.9rem; }
  .nl-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.4rem; margin-top: 1.4rem; }
  .nl-card { display: flex; flex-direction: column; gap: 0.7rem; text-decoration: none; color: inherit; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .nl-card:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: var(--shadow-lg); }
  .nl-card h3 { font-size: 1.2rem; }
  .nl-card p { color: var(--text-muted); font-size: 0.98rem; line-height: 1.6; flex: 1; }
  .nl-card-link { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--accent); font-weight: 600; font-size: 0.95rem; }
  .nl-card-link :global(svg) { width: 16px; height: 16px; transition: transform .18s ease; }
  .nl-card:hover .nl-card-link :global(svg) { transform: translateX(3px); }
</style>
