---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import Button from "@/components/Button.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { site, caseStudies } from "@/data/site";
import { services } from "@/data/services";

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const url = `${site.url}/nl/${s.slug}/`;
const relCase = caseStudies.find((c) => c.slug === s.caseSlug);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: s.keyword,
      description: s.lead,
      provider: { "@id": `${site.url}/#organization` },
      areaServed: site.areaServed.map((a) => ({ "@type": "Place", name: a })),
      url,
      offers: s.pricing.items.map((i) => ({ "@type": "Offer", name: i.name, description: i.price })),
    },
    {
      "@type": "FAQPage",
      "@id": `${url}#faq`,
      mainEntity: s.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---
<Base lang="nl" title={s.title} description={s.description}>
  <!-- Hero -->
  <section class="page-hero">
    <div class="container center" style="max-width:840px">
      <span class="eyebrow" data-reveal>{site.city}</span>
      <h1 data-reveal data-delay="60">{s.h1}</h1>
      <p class="lead" data-reveal data-delay="120" style="margin:1.4rem auto 0;max-width:680px">{s.lead}</p>
      <div class="hero-actions" data-reveal data-delay="180">
        <Button href="/contact/" variant="brand" size="lg" arrow>{s.cta}</Button>
        <WhatsAppButton label="WhatsApp" />
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="section">
    <div class="container container-narrow">
      <div class="prose" data-reveal>
        {s.intro.map((p) => <p>{p}</p>)}
      </div>
      <div class="block card" data-reveal>
        <span class="block-label">Voor wie</span>
        <p>{s.forWho}</p>
      </div>
      {s.extra && (
        <div class="prose extra" data-reveal>
          <h2 class="extra-h">Waarom Webmaister</h2>
          {s.extra.map((p) => <p>{p}</p>)}
        </div>
      )}
    </div>
  </section>

  <!-- Werkwijze -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Onze aanpak</span>
        <h2>Zo werken we</h2>
      </div>
      <ol class="steps">
        {s.steps.map((st, i) => (
          <li class="step" data-reveal data-delay={i * 50}>
            <span class="step-n">{String(i + 1).padStart(2, "0")}</span>
            <div><h3>{st.title}</h3><p>{st.text}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Prijzen -->
  <section class="section">
    <div class="container container-narrow">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Prijzen</span>
        <h2>Wat kost het?</h2>
      </div>
      <p class="lead" data-reveal style="margin-bottom:1.6rem">{s.pricing.text}</p>
      <ul class="price-list" data-reveal>
        {s.pricing.items.map((i) => (
          <li><span class="pl-name">{i.name}</span><span class="pl-price">{i.price}</span></li>
        ))}
      </ul>
      <p class="price-note" data-reveal>Typische levertijd: {site.deliveryTime} per pakket. Prijzen zijn vanaf-prijzen; in een gratis gesprek maken we een offerte op maat.</p>
    </div>
  </section>

  <!-- Relevante case -->
  {relCase && (
    <section class="section section-alt">
      <div class="container container-narrow">
        <div class="case-callout card" data-reveal>
          <span class="block-label">Relevante case</span>
          <h3>{relCase.company}</h3>
          <p>{s.caseText}</p>
          <div class="case-actions">
            <a class="text-link" href={`/cases/#${relCase.slug}`}>Bekijk de case <Icon name="arrow" /></a>
            {relCase.website && <a class="text-link muted" href={relCase.website.href} target="_blank" rel="noopener noreferrer">Bekijk {relCase.website.label} <Icon name="arrow" /></a>}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Veelgestelde vragen</span>
        <h2>Goed om te weten</h2>
      </div>
      <FaqAccordion items={s.faq} />
    </div>
  </section>

  <!-- Related + CTA -->
  <section class="section section-alt">
    <div class="container center" style="max-width:720px">
      <div class="related" data-reveal>
        <span class="eyebrow">Gerelateerde diensten</span>
        <ul>{s.related.map((r) => <li><a href={r.href}>{r.label} <Icon name="arrow" /></a></li>)}</ul>
      </div>
      <h2 data-reveal style="margin-top:2.4rem">Klaar om te groeien in {site.city}?</h2>
      <p class="lead" data-reveal style="margin:1rem auto 1.8rem">Plan een gratis gesprek. We bekijken je situatie en maken een helder plan.</p>
      <div class="hero-actions center" data-reveal>
        <Button href="/contact/" variant="brand" size="lg" arrow>{s.cta}</Button>
        <WhatsAppButton label="WhatsApp" />
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>

<style>
  .page-hero { padding-block: clamp(60px, 9vw, 120px) clamp(44px, 6vw, 76px); background: var(--grad-soft); border-bottom: 1px solid var(--line); }
  .hero-actions { display: flex; gap: 0.8rem; justify-content: center; align-items: center; flex-wrap: wrap; margin-top: 2rem; }
  .hero-actions.center { justify-content: center; }
  .prose p { font-size: clamp(1.05rem, 1.9vw, 1.2rem); line-height: 1.7; color: var(--text); }
  .prose p + p { margin-top: 1.1rem; }
  .block { margin-top: 2.4rem; }
  .block-label { display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--brand-strong); margin-bottom: 0.7rem; }
  .block p { color: var(--text-muted); line-height: 1.65; }
  .extra { margin-top: 2.4rem; }
  .extra-h { font-size: clamp(1.4rem, 3vw, 1.9rem); margin-bottom: 1rem; }
  .section-head { max-width: 720px; margin-bottom: 2rem; }
  .section-head.center { margin-inline: auto; text-align: center; }

  .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: clamp(1.2rem, 3vw, 2rem); margin-top: 2.6rem; }
  .step { display: flex; gap: 1rem; align-items: flex-start; }
  .step-n { font-size: 1.1rem; font-weight: 700; color: var(--brand-strong); background: var(--bg-tint); width: 46px; height: 46px; border-radius: 13px; display: grid; place-items: center; flex-shrink: 0; border: 1px solid rgba(10,142,242,0.16); }
  .step h3 { font-size: 1.1rem; margin-bottom: 0.3rem; }
  .step p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.55; }

  .price-list { display: grid; gap: 0; border-top: 1px solid var(--line); }
  .price-list li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.9rem 0; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .pl-name { font-weight: 560; color: var(--text); }
  .pl-price { color: var(--brand-strong); font-weight: 700; white-space: nowrap; }
  .price-note { margin-top: 1.2rem; font-size: 0.9rem; color: var(--text-faint); }

  .case-callout h3 { font-size: 1.4rem; margin-bottom: 0.6rem; }
  .case-callout p { color: var(--text-muted); line-height: 1.65; margin-bottom: 1.1rem; }
  .case-actions { display: flex; gap: 1.4rem; flex-wrap: wrap; }
  .text-link { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; color: var(--brand-strong); }
  .text-link.muted { color: var(--text-muted); }
  .text-link :global(svg) { width: 16px; height: 16px; }

  .related ul { display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; justify-content: center; margin-top: 0.8rem; }
  .related a { display: inline-flex; align-items: center; gap: 0.35rem; font-weight: 600; color: var(--brand-strong); font-size: 0.95rem; }
  .related :global(svg) { width: 15px; height: 15px; }
</style>
