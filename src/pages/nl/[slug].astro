---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import Button from "@/components/Button.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import { site, nlLandings } from "@/data/site";

export function getStaticPaths() {
  return nlLandings.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const url = `${site.url}/nl/${page.slug}/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: page.keyword,
      description: page.lead,
      provider: { "@id": `${site.url}/#organization` },
      areaServed: site.areaServed.map((a) => ({ "@type": "Place", name: a })),
      url,
    },
    {
      "@type": "FAQPage",
      "@id": `${url}#faq`,
      mainEntity: page.faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---
<Base lang="nl" title={page.title} description={page.description}>
  <section class="page-hero">
    <div class="container center" style="max-width:820px">
      <span class="eyebrow" data-reveal>Rotterdam</span>
      <h1 data-reveal data-delay="60">{page.h1}</h1>
      <p class="lead" data-reveal data-delay="120" style="margin:1.4rem auto 0;max-width:640px">{page.lead}</p>
      <div class="hero-cta" data-reveal data-delay="180">
        <Button href="/contact/" variant="brand" size="lg" arrow>Plan een gratis gesprek</Button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <div class="nl-intro" data-reveal>
        {page.intro.map((p) => <p>{p}</p>)}
      </div>
      <div class="nl-includes card" data-reveal>
        <h2>{page.includesTitle}</h2>
        <ul>
          {page.includes.map((item) => (
            <li><Icon name="check" /> <span>{item}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Veelgestelde vragen</span>
        <h2>Goed om te weten</h2>
      </div>
      <FaqAccordion items={page.faq} />
    </div>
  </section>

  <section class="section">
    <div class="container center" style="max-width:680px">
      <h2 data-reveal>Klaar om te groeien?</h2>
      <p class="lead" data-reveal style="margin:1rem auto 1.8rem">Plan een gratis strategiegesprek. We bekijken je situatie in Rotterdam en maken een helder plan om meer klanten aan te trekken.</p>
      <Button href="/contact/" variant="brand" size="lg" arrow>Plan een gratis gesprek</Button>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>

<style>
  .page-hero { padding-block: clamp(60px, 9vw, 120px) clamp(48px, 6vw, 80px); background: var(--grad-soft); border-bottom: 1px solid var(--line); }
  .hero-cta { margin-top: 2rem; }
  .nl-intro p { font-size: clamp(1.05rem, 1.9vw, 1.25rem); line-height: 1.65; color: var(--text); }
  .nl-intro p + p { margin-top: 1.1rem; }
  .nl-includes { margin-top: 2.5rem; }
  .nl-includes h2 { font-size: 1.4rem; margin-bottom: 1.1rem; }
  .nl-includes ul { display: grid; gap: 0.7rem; }
  .nl-includes li { display: flex; align-items: flex-start; gap: 0.6rem; font-size: 1rem; color: var(--text); }
  .nl-includes :global(svg) { width: 19px; height: 19px; color: var(--accent); flex-shrink: 0; margin-top: 3px; }
</style>
