---
import Base from "@/layouts/Base.astro";
import FinalCta from "@/components/FinalCta.astro";
import { site, core, caseStudies } from "@/data/site";
import { alternatesFor } from "@/i18n";

const facts = [
  { label: "Opgericht", value: site.founded },
  { label: "Gevestigd in", value: `${site.streetAddress}, ${site.postalCode} ${site.city}` },
  { label: "KvK", value: site.kvk },
  { label: "Werkgebied", value: site.areaServed.join(" · ") },
];
---
<Base
  title="Over Webmaister · Junalda Meiland, oprichter | Rotterdam"
  description={core.nl}
  lang="nl"
  alternates={alternatesFor("/over-ons/", "/en/about/")}
>
  <section class="page-hero">
    <div class="container center" style="max-width:820px">
      <span class="eyebrow" data-reveal>Over Webmaister</span>
      <h1 data-reveal data-delay="60">Websites die gevonden worden<br><span class="gradient-text">op Google én in AI.</span></h1>
      <p class="lead" data-reveal data-delay="120" style="margin:1.4rem auto 0;max-width:640px">{core.nl}</p>
    </div>
  </section>

  <section class="section">
    <div class="container founder-grid">
      <figure class="founder-photo" data-reveal>
        <img src="/junalda.jpg" alt="Junalda Meiland, oprichter van Webmaister" width="1717" height="2576" />
      </figure>
      <div class="founder-copy" data-reveal>
        <span class="eyebrow">Oprichter</span>
        <h2>Junalda Meiland, oprichter</h2>
        <p>Junalda Meiland heeft meer dan 10 jaar ervaring in technologie, een achtergrond in softwareontwikkeling en IT-projectmanagement, en is ondernemer sinds 2016. Ze werkt vanuit Rotterdam.</p>
        <p>Haar aanpak: eerst kijken waar het bedrijf naartoe wil, en daarna de website, de vindbaarheid en de automatisering bouwen.</p>
        <p><a class="founder-link" href={site.social.founderLinkedin} target="_blank" rel="noopener noreferrer">LinkedIn van Junalda Meiland</a></p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container container-narrow about-intro" data-reveal>
      <h2>Waarom Webmaister bestaat</h2>
      <p>{core.nl}</p>
      <p>Een site die er goed uitziet maar niet gevonden wordt, brengt het bedrijf niet waar het naartoe wil. Webmaister bouwt de website, de vindbaarheid op Google en in AI-assistenten zoals ChatGPT, en de automatisering voor ondersteuning, afspraken, opvolging en administratie als één geheel.</p>
      <h2>Hoe we werken</h2>
      <p>Een One-Pager staat binnen 7 dagen live. Daarna houden we de site bij. Het maandbedrag dekt onderhoud, en bij Growth Essentials ook de vindbaarheid op Google en in AI. We bouwen maatwerk in code.</p>
      <h2>Voor wie</h2>
      <p>Voor ondernemers en het MKB. We zitten in Rotterdam en werken in Rotterdam, Zuid-Holland en de rest van Nederland, ook op afstand.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">In het kort</span>
        <h2>De feiten</h2>
      </div>
      <ul class="facts grid grid-4" data-reveal>
        {facts.map((f) => (
          <li class="fact card">
            <span class="fact-label">{f.label}</span>
            <span class="fact-value">{f.value}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Werk</span>
        <h2>Cases</h2>
      </div>
      <ul class="case-links" data-reveal>
        {caseStudies.map((cs) => (
          <li><a href={`/cases/#${cs.slug}`}>Bekijk de case van {cs.company}</a></li>
        ))}
      </ul>
      <p class="case-more" data-reveal><a href="/cases/">Alle cases van Webmaister</a> · <a href="/contact/">Neem contact op met Webmaister</a></p>
    </div>
  </section>

  <FinalCta
    title="Bekijk de pakketten<br>en prijzen."
    text="One-Pager €500 setup + €150 per maand, live binnen 7 dagen. Growth Essentials €2.700 setup + €300 per maand. Growth Partnership is op aanvraag."
    eyebrow="Start"
    ctaHref="/start/"
    ctaLabel="Bekijk pakketten en prijzen"
    secondaryHref="/diensten/"
    secondaryLabel="Bekijk onze diensten"
  />
</Base>

<style>
  .page-hero { padding-block: clamp(60px, 9vw, 120px) clamp(40px, 6vw, 70px); background: var(--grad-soft); border-bottom: 1px solid var(--line); }
  .founder-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(1.6rem, 4vw, 3.5rem); align-items: center; }
  .founder-photo { margin: 0; }
  .founder-photo img { width: 100%; height: auto; border-radius: var(--r-lg); object-fit: cover; max-height: 640px; }
  .founder-copy h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0.4rem 0 1rem; }
  .founder-copy p { font-size: clamp(1.05rem, 2vw, 1.2rem); line-height: 1.65; color: var(--text); }
  .founder-copy p + p { margin-top: 1rem; }
  .founder-link { font-weight: 600; color: var(--brand-strong); }
  .about-intro h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin: 2rem 0 0.8rem; }
  .about-intro h2:first-child { margin-top: 0; }
  .about-intro p { font-size: clamp(1.1rem, 2vw, 1.3rem); line-height: 1.65; color: var(--text); }
  .about-intro p + p { margin-top: 1.3rem; }
  .facts { margin-top: 3rem; }
  .fact { display: flex; flex-direction: column; gap: 0.35rem; text-align: center; }
  .fact-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--brand-strong); }
  .fact-value { font-size: 1.05rem; font-weight: 650; color: var(--ink); }
  .case-links { display: grid; gap: 0.8rem; max-width: 640px; margin: 2rem auto 0; }
  .case-links a, .case-more a { font-weight: 600; color: var(--brand-strong); }
  .case-more { text-align: center; margin-top: 1.6rem; color: var(--text-muted); }
  @media (max-width: 800px) {
    .founder-grid { grid-template-columns: 1fr; }
    .founder-photo img { max-height: 480px; }
  }
</style>
