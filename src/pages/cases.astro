---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import FinalCta from "@/components/FinalCta.astro";
import Testimonials from "@/components/Testimonials.astro";
import { caseStudies } from "@/data/site";
import { alternatesFor } from "@/i18n";

// NL summaries per case (translated from the case narratives).
const summaries: Record<string, { industry: string; text: string }> = {
  "nursitree": { industry: "Urban greening & groene infrastructuur", text: "NursiTree introduceert een herbruikbare boombunker waarmee bomen gedijen in de stad. Zo'n innovatie moet in seconden begrepen en vertrouwd worden. We bouwden een digitaal platform dat de innovatie helder uitlegt en NursiTree de geloofwaardigheid geeft die de missie verdient." },
  "queenly-events": { industry: "Luxe events & weddingplanning", text: "Queenly Events levert prachtige events, maar de online presentatie communiceerde de premiumkwaliteit niet. We herontwierpen de digitale ervaring rond luxe, vertrouwen en emotie, zodat de site de kwaliteit van hun werk weerspiegelt." },
  "capture-the-moment-solutions": { industry: "Visual storytelling & content creation", text: "Gabriel had een sterke creatieve visie, maar zijn aanbod leefde vooral in een portfolio. We maakten er een helder, premium platform van met structuur, positionering en conversielogica, zodat bezoekers de waarde van zijn werk meteen begrijpen." },
  "hope-love-foundation": { industry: "Non-profit & kinderstichting", text: "Hope & Love Foundation helpt kinderen ontdekken wie ze zijn en dat ze erbij horen. Zo'n persoonlijke missie moet je voelen. We bouwden een warm, betrouwbaar platform dat de impact helder maakt en donateurs en partners het vertrouwen geeft om bij te dragen." },
};
---
<Base
  title="Cases · Webmaister — echte bedrijven, echte fundamenten"
  description="Bekijk hoe Webmaister digitale fundamenten bouwt voor echte bedrijven: NursiTree, Queenly Events, Capture the Moment Solutions en Hope & Love Foundation."
  lang="nl"
  alternates={alternatesFor("/cases/", "/en/work/")}
>
  <section class="page-hero">
    <div class="container center" style="max-width:820px">
      <span class="eyebrow" data-reveal>Cases</span>
      <h1 data-reveal data-delay="60">Gebouwd voor <span class="gradient-text">echte bedrijven.</span></h1>
      <p class="lead" data-reveal data-delay="120" style="margin:1.4rem auto 0;max-width:640px">
        Van groene infrastructuur tot luxe events en visual storytelling, elk bedrijf start op een andere plek.
        Wat ze delen is de ambitie om te groeien, en een digitaal fundament dat hen daarnaartoe brengt.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:920px">
      <ul class="case-list">
        {caseStudies.map((cs) => {
          const s = summaries[cs.slug];
          return (
            <li class="case-row" id={cs.slug} data-reveal>
              <span class="case-industry">{s?.industry ?? cs.cardIndustry}</span>
              <h2 class="case-name">{cs.company}</h2>
              <p class="case-text">{s?.text ?? cs.cardText}</p>
              <div class="case-meta">
                {cs.website && <a class="case-link" href={cs.website.href} target="_blank" rel="noopener noreferrer">Bekijk {cs.website.label} <Icon name="arrow" /></a>}
                {cs.founders?.map((f) => (
                  <a class="case-founder" href={f.href} target="_blank" rel="noopener noreferrer">{f.name}</a>
                ))}
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <Testimonials lang="nl" />

  <FinalCta
    title="Jouw transformatie<br>begint met een gesprek."
    text="Plan een gratis gesprek en we schetsen een helder pad naar het digitale fundament dat jouw bedrijf nodig heeft om te groeien."
    eyebrow="Klaar om te groeien"
    ctaHref="/contact/"
    ctaLabel="Plan een gesprek"
    secondaryHref="/diensten/"
    secondaryLabel="Bekijk onze diensten"
  />
</Base>

<style>
  .page-hero { padding-block: clamp(60px, 9vw, 120px) clamp(40px, 6vw, 70px); background: var(--grad-soft); border-bottom: 1px solid var(--line); }
  .case-list { display: grid; gap: 0; }
  .case-row { border-top: 1px solid var(--line); padding-block: clamp(2rem, 4vw, 3rem); }
  .case-row:last-child { border-bottom: 1px solid var(--line); }
  .case-industry { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--brand-strong); }
  .case-name { font-size: clamp(1.6rem, 4vw, 2.6rem); margin: 0.6rem 0 0.8rem; }
  .case-text { color: var(--text-muted); line-height: 1.65; max-width: 62ch; margin-bottom: 1.2rem; }
  .case-meta { display: flex; flex-wrap: wrap; gap: 0.8rem 1.6rem; align-items: center; }
  .case-link { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; color: var(--brand-strong); }
  .case-link :global(svg) { width: 16px; height: 16px; }
  .case-founder { font-size: 0.9rem; color: var(--text-muted); text-decoration: underline; text-underline-offset: 2px; }
  .case-founder:hover { color: var(--brand-strong); }
</style>
