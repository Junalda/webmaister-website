---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import FinalCta from "@/components/FinalCta.astro";
import { caseStudies } from "@/data/site";
---
<Base
  title="Success Stories · Measurable Growth & ROI"
  description="See how Webmaister helps Rotterdam businesses grow: real case studies with measurable ROI across premium websites, SEO growth systems and Brainy AI automation."
>
  <section class="page-hero">
    <div class="container center" style="max-width:780px">
      <span class="eyebrow" data-reveal>Success stories</span>
      <h1 data-reveal data-delay="60">Proof that the right<br><span class="gradient-text">foundation pays off.</span></h1>
      <p class="lead" data-reveal data-delay="120" style="margin:1.4rem auto 0;max-width:600px">
        Every engagement is measured in business outcomes — leads, hours saved and revenue.
        Here's what that looks like in practice.
      </p>
      <div class="roi-strip" data-reveal data-delay="180">
        <div><strong>3.4×</strong><span>more qualified leads</span></div>
        <div><strong>68%</strong><span>tickets auto-resolved</span></div>
        <div><strong>€4.2k</strong><span>monthly cost saved</span></div>
        <div><strong>+38%</strong><span>conversion lift</span></div>
      </div>
    </div>
  </section>

  {caseStudies.map((cs, i) => (
    <section class:list={["section", { "section-alt": i % 2 === 1 }]}>
      <div class="container">
        <article class="case" data-reveal>
          <header class="case-head">
            <span class="badge"><Icon name="layers" style="width:14px;height:14px" /> {cs.industry}</span>
            <h2>{cs.company}</h2>
          </header>

          <div class="case-grid">
            <div class="case-narrative">
              <div class="cn-block">
                <span class="cn-label challenge">Challenge</span>
                <p>{cs.challenge}</p>
              </div>
              <div class="cn-block">
                <span class="cn-label solution">Solution</span>
                <p>{cs.solution}</p>
              </div>
              <blockquote class="case-quote">
                <p>"{cs.quote}"</p>
                <cite>— {cs.author}, {cs.company}</cite>
              </blockquote>
            </div>

            <aside class="case-results card">
              <span class="cn-label results">Results</span>
              <ul>
                {cs.results.map((r) => (
                  <li>
                    <strong class="gradient-text">{r.metric}</strong>
                    <span>{r.label}</span>
                  </li>
                ))}
              </ul>
              <p class="results-note"><Icon name="trend" /> Measured ROI, not vanity metrics.</p>
            </aside>
          </div>
        </article>
      </div>
    </section>
  ))}

  <section class="section section-dark">
    <div class="container center" style="max-width:720px">
      <span class="eyebrow" style="color:var(--accent)" data-reveal>Why it works</span>
      <h2 data-reveal>The same playbook, applied to your business.</h2>
      <p class="lead" data-reveal>
        Each result above came from the same approach: a premium digital foundation, growth
        systems that bring the right customers in, and Brainy handling the repetitive work 24/7.
        Different industries, same compounding outcome.
      </p>
    </div>
  </section>

  <FinalCta
    title="Your success story<br>starts with a conversation."
    text="Book a free Growth Strategy Call and we'll map the fastest path to measurable results for your business."
  />
</Base>

<style>
  .page-hero { padding-block: clamp(60px, 9vw, 120px) clamp(40px, 6vw, 70px); background: var(--grad-soft); border-bottom: 1px solid var(--line); }
  .roi-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 2.8rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .roi-strip div { display: flex; flex-direction: column; }
  .roi-strip strong { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: var(--ink); }
  .roi-strip span { font-size: 0.84rem; color: var(--text-muted); }
  @media (max-width: 620px) { .roi-strip { grid-template-columns: repeat(2, 1fr); gap: 1.4rem 1rem; } }

  .case-head { margin-bottom: 2rem; }
  .case-head h2 { margin-top: 0.8rem; }
  .case-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  .cn-block { margin-bottom: 1.8rem; }
  .cn-label {
    display: inline-block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; padding: 4px 10px; border-radius: var(--r-pill); margin-bottom: 0.7rem;
  }
  .cn-label.challenge { color: #e5484d; background: #fff0f1; }
  .cn-label.solution { color: var(--brand-strong); background: var(--bg-tint); }
  .cn-label.results { color: var(--accent); background: rgba(0,212,177,0.1); }
  .cn-block p { font-size: 1.02rem; line-height: 1.6; }
  .case-quote { margin-top: 2rem; padding: 1.4rem 1.6rem; background: var(--bg-alt); border-left: 3px solid var(--brand); border-radius: 0 var(--r-md) var(--r-md) 0; }
  .case-quote p { color: var(--text); font-size: 1.05rem; font-style: italic; }
  .case-quote cite { display: block; margin-top: 0.7rem; font-style: normal; font-size: 0.86rem; color: var(--text-faint); }

  .case-results { position: sticky; top: calc(var(--nav-h) + 20px); }
  .case-results ul { display: flex; flex-direction: column; gap: 1.3rem; margin: 1.2rem 0 1.5rem; }
  .case-results li { display: flex; flex-direction: column; gap: 0.2rem; padding-bottom: 1.3rem; border-bottom: 1px solid var(--line); }
  .case-results li:last-child { border-bottom: none; padding-bottom: 0; }
  .case-results strong { font-size: 2.4rem; font-weight: 700; letter-spacing: -0.03em; line-height: 1; }
  .case-results span { font-size: 0.92rem; color: var(--text-muted); }
  .results-note { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--text-faint); }
  .results-note :global(svg) { width: 16px; height: 16px; color: var(--accent); }

  @media (max-width: 860px) { .case-grid { grid-template-columns: 1fr; } .case-results { position: static; } }
</style>
