---
import Base from "@/layouts/Base.astro";
import HomeView from "@/components/HomeView.astro";
import { homeNL } from "@/data/home";
import { alternatesFor } from "@/i18n";

const t = homeNL;
const links = { contact: "/contact/", solutions: "/diensten/", cases: "/cases/" };
---
<Base title={t.meta.title} description={t.meta.description} lang="nl" alternates={alternatesFor("/", "/en/")}>
  <HomeView t={t} links={links} />
</Base>
