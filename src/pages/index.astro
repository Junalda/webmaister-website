---
import Base from "@/layouts/Base.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { site, caseStudies, ctaPrimary, ctaSecondary } from "@/data/site";

// --- Section 02: the problem, as editorial statements ---
const problems = [
  { n: "01", a: "Referrals are great.", b: "Until they slow down." },
  { n: "02", a: "A beautiful website is great.", b: "Until nobody converts." },
  { n: "03", a: "Running ads is great.", b: "Until the budget stops." },
];

// --- Section 03: four service pillars ---
const pillars = [
  {
    n: "01",
    title: "Strategy & Positioning",
    desc: "We help businesses clarify their positioning, refine their offers, and build a practical growth strategy.",
    items: ["Business positioning", "Offer development", "Customer journey strategy", "Acquisition strategy", "Growth planning"],
  },
  {
    n: "02",
    title: "Websites & Conversion",
    desc: "We design and develop websites that build credibility and turn interest into inquiries.",
    items: ["Business websites", "High-converting landing pages", "One-page websites", "E-commerce websites", "Conversion optimization", "SEO foundations"],
  },
  {
    n: "03",
    title: "Customer Acquisition",
    desc: "We help businesses build more structured ways to reach and convert potential customers.",
    items: ["Acquisition funnels", "Lead generation", "Google Ads", "Campaign landing pages", "Conversion tracking", "Lead follow-up processes"],
  },
  {
    n: "04",
    title: "Systems & Automation",
    desc: "We connect technology and processes to reduce manual work and improve the customer journey.",
    items: ["CRM integrations", "Lead management", "Workflow automation", "AI-assisted processes", "Business system integrations", "Customer follow-up automation"],
  },
];

// --- Section 04: partnership approach ---
const approach = [
  { n: "01", title: "Understand", text: "We analyze the business, its offer, customers, existing channels, and growth opportunities." },
  { n: "02", title: "Build", text: "We improve the foundations: positioning, website, conversion paths, and acquisition systems." },
  { n: "03", title: "Optimize", text: "We monitor performance, identify bottlenecks, and improve what works." },
  { n: "04", title: "Scale", text: "We strengthen successful channels and develop a more sustainable approach to customer acquisition." },
];

// --- Section 05: services & investment ---
const offers = [
  { name: "One-Page Website", price: "€500", unit: "setup", recurring: "+ €150 / month", who: "For entrepreneurs who need a professional online presence without unnecessary complexity.", cta: "Discuss Your Website" },
  { name: "Business Website", price: "€2,700", unit: "setup", recurring: "+ €300 / month", who: "For growing businesses that need stronger positioning, professional presentation, and conversion-focused development.", cta: "Build a Better Website" },
  { name: "Lead Generation System", price: "€5,000", unit: "setup", recurring: "+ €500 / month", who: "For businesses that want to connect their website, conversion process, and lead acquisition into a structured system.", cta: "Discuss Lead Generation" },
  { name: "Growth Strategy Partnership", price: "From €1,600", unit: "per month", recurring: "Minimum six-month engagement", who: "For businesses looking for strategic guidance and ongoing improvement of their acquisition systems.", cta: "Let's Talk Growth", flagship: true },
];
const addOns = [
  "Website maintenance — from €150 / month",
  "Ads management — from €449 / month",
  "E-commerce development — from €2,500 setup",
  "Custom e-commerce front-end — from €3,500 setup",
  "E-commerce recurring services — from €350 / month",
  "Paid strategy session — €350",
];

// --- Section 06: differentiators ---
const differentiators = [
  "Strategy before execution",
  "Custom-built solutions instead of generic templates",
  "Technology connected to business objectives",
  "Ongoing optimization instead of one-off delivery",
  "Direct communication",
  "Focus on long-term growth",
];

// --- Section 08: how we start ---
const steps = [
  { n: "01", title: "Conversation", text: "We discuss your business, goals, and current acquisition challenges." },
  { n: "02", title: "Direction", text: "We identify the most relevant opportunities and determine whether we're the right partner." },
  { n: "03", title: "Proposal", text: "We outline a tailored approach, deliverables, investment, and next steps." },
];

const marquee = ["Systems built for growth", "Strategy", "Positioning", "Websites", "Customer acquisition", "Automation"];
---
<Base
  title="Webmaister · Growth & Acquisition Partner — Systems Built for Growth"
  description="Webmaister helps growing businesses turn outdated websites, disconnected marketing, and unpredictable customer acquisition into systems built for growth. Based in Rotterdam. Let's talk growth."
>
  <!-- ============ 01 · HERO ============ -->
  <section class="hero">
    <div class="container">
      <p class="kicker" data-reveal>Growth &amp; Acquisition Partner</p>
      <h1 class="display hero-h" data-reveal data-delay="60">
        Your business grew.<br /><span class="muted-head">Your systems didn't.</span>
      </h1>
      <p class="hero-sub" data-reveal data-delay="120">
        We help growing businesses turn outdated websites, disconnected marketing, and unpredictable
        customer acquisition into systems built for growth.
      </p>
      <div class="actions" data-reveal data-delay="180">
        <Button href={ctaPrimary.href} variant="primary" size="lg" arrow>Let's Talk Growth</Button>
        <Button href={ctaSecondary.href} variant="ghost" size="lg">Explore Our Services</Button>
      </div>
    </div>
  </section>

  <!-- marquee band -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[...marquee, ...marquee].map((m) => <span class="marquee-item">{m}<i>/</i></span>)}
    </div>
  </div>

  <!-- ============ 02 · THE PROBLEM ============ -->
  <section class="section section-ink">
    <div class="container">
      <h2 class="display sect-h" data-reveal>Growth shouldn't<br />depend on luck.</h2>
      <ul class="statements">
        {problems.map((p) => (
          <li class="statement" data-reveal>
            <span class="statement-n display">{p.n}</span>
            <p><strong>{p.a}</strong> <span class="dim">{p.b}</span></p>
          </li>
        ))}
      </ul>
      <div class="big-statement" data-reveal>
        <p class="display">Most businesses don't have a marketing problem.<br /><span class="accent-head">They have a systems problem.</span></p>
        <p class="aside">More activity isn't always the answer. A better-connected system is.</p>
      </div>
    </div>
  </section>

  <!-- ============ 03 · WHAT WE DO ============ -->
  <section class="section" id="services">
    <div class="container">
      <p class="kicker" data-reveal>What we do</p>
      <h2 class="display sect-h" data-reveal>We connect the dots.</h2>
      <p class="sect-intro" data-reveal>
        Strategy. Websites. Acquisition. Automation. Individually, they're useful.
        Together, they create a foundation for growth.
      </p>
      <div class="pillars">
        {pillars.map((p, i) => (
          <article class:list={["pillar", { alt: i % 2 === 1 }]} data-reveal>
            <span class="pillar-n display">{p.n}</span>
            <div class="pillar-body">
              <h3 class="display">{p.title}</h3>
              <p class="pillar-desc">{p.desc}</p>
              <ul class="pillar-items">
                {p.items.map((it) => <li>{it}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
      <p class="sect-foot" data-reveal>
        <a href="/solutions/" class="text-link">Explore all services <Icon name="arrow" /></a>
      </p>
    </div>
  </section>

  <!-- ============ 04 · THE GROWTH PARTNERSHIP ============ -->
  <section class="section section-ink" id="approach">
    <div class="container">
      <p class="kicker accent" data-reveal>The growth partnership</p>
      <h2 class="display sect-h" data-reveal>Six months.<br /><span class="accent-head">One clear direction.</span></h2>
      <p class="sect-intro dim" data-reveal>
        Real growth requires more than a new website or another marketing campaign. We work with
        businesses over six months to strengthen their positioning, connect their acquisition
        channels, and build systems designed to generate more consistent opportunities.
      </p>
      <div class="approach">
        {approach.map((s) => (
          <div class="app-step" data-reveal>
            <span class="app-n display">{s.n}</span>
            <h3 class="display">{s.title}</h3>
            <p class="dim">{s.text}</p>
          </div>
        ))}
      </div>

      <div class="guarantee" data-reveal>
        <h3 class="display">We back our work.</h3>
        <p class="dim">
          We agree on measurable objectives before starting. If the agreed results are not achieved
          within six months, we refund the startup fee, subject to the agreed terms and clearly
          documented objectives. This commitment reflects our confidence in our approach.
        </p>
        <div class="actions"><Button href="/contact/" variant="brand" size="lg" arrow>Discuss Your Growth Plan</Button></div>
      </div>
    </div>
  </section>

  <!-- ============ 05 · SERVICES & INVESTMENT ============ -->
  <section class="section">
    <div class="container">
      <p class="kicker" data-reveal>Services &amp; investment</p>
      <h2 class="display sect-h" data-reveal>Clear entry points.</h2>
      <div class="offers">
        {offers.map((o) => (
          <article class:list={["offer", { flagship: o.flagship }]} data-reveal>
            {o.flagship && <span class="offer-flag">Flagship</span>}
            <h3 class="display offer-name">{o.name}</h3>
            <p class="offer-price"><span class="display">{o.price}</span> <span class="offer-unit">{o.unit}</span></p>
            <p class="offer-rec">{o.recurring}</p>
            <p class="offer-who">{o.who}</p>
            <a href="/contact/" class="offer-cta">{o.cta} <Icon name="arrow" /></a>
          </article>
        ))}
      </div>
      <div class="addons" data-reveal>
        <span class="addons-label">Additional services</span>
        <ul>{addOns.map((a) => <li>{a}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- ============ 06 · WHY WEBMAISTER + FOUNDER ============ -->
  <section class="section section-soft">
    <div class="container">
      <p class="kicker" data-reveal>Why Webmaister</p>
      <h2 class="display sect-h" data-reveal>Technology is the tool.<br /><span class="accent-head">Growth is the goal.</span></h2>
      <div class="why-grid">
        <div class="why-copy" data-reveal>
          <p>
            A website alone won't grow your business. Neither will another disconnected marketing
            campaign. What matters is how your positioning, customer journey, acquisition channels,
            and technology work together. That's where we focus.
          </p>
          <ul class="diff-list">
            {differentiators.map((d) => <li><Icon name="check" /> <span>{d}</span></li>)}
          </ul>
        </div>
        <aside class="founder" data-reveal>
          <span class="founder-label">The founder</span>
          <p class="founder-name display">Junalda Meiland</p>
          <p class="founder-role">Founder, Webmaister</p>
          <p class="founder-bio">
            Junalda brings 10+ years in technology, a background in software development and IT project
            management, and hands-on experience building and operating businesses as an entrepreneur
            since 2016. That combination — technology and business, not one without the other — is how
            Webmaister approaches growth.
          </p>
          <a href={`https://wa.me/${site.whatsappHref}`} class="text-link" target="_blank" rel="noopener noreferrer">Talk to Junalda <Icon name="arrow" /></a>
        </aside>
      </div>
    </div>
  </section>

  <!-- ============ 07 · SELECTED WORK ============ -->
  <section class="section section-ink" id="work">
    <div class="container">
      <p class="kicker accent" data-reveal>Selected work</p>
      <h2 class="display sect-h" data-reveal>Built for real businesses.</h2>
      <ul class="work-list">
        {caseStudies.map((cs) => (
          <li class="work-item" data-reveal>
            <a href={`/success-stories/#${cs.slug}`} class="work-link">
              <span class="work-industry">{cs.cardIndustry}</span>
              <span class="work-name display">{cs.company}</span>
              <span class="work-headline dim">{cs.headline}</span>
              <span class="work-go">View case <Icon name="arrow" /></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="sect-foot" data-reveal>
        <a href="/success-stories/" class="text-link accent">See all success stories <Icon name="arrow" /></a>
      </p>
    </div>
  </section>

  <!-- ============ 08 · HOW WE START ============ -->
  <section class="section">
    <div class="container">
      <p class="kicker" data-reveal>How we start</p>
      <h2 class="display sect-h" data-reveal>Let's find out what's<br />holding you back.</h2>
      <p class="sect-intro" data-reveal>
        Every business is different. Before recommending a website, campaign, or growth partnership,
        we first look at where your business stands and what needs to improve.
      </p>
      <div class="approach light">
        {steps.map((s) => (
          <div class="app-step" data-reveal>
            <span class="app-n display">{s.n}</span>
            <h3 class="display">{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
      <div class="start-cta" data-reveal>
        <Button href="/contact/" variant="primary" size="lg" arrow>Book a Discovery Call</Button>
        <WhatsAppButton label="WhatsApp us" />
        <p class="start-note">The initial discovery conversation is free and separate from our paid in-depth strategy session.</p>
      </div>
    </div>
  </section>

  <!-- ============ 09 · FINAL CTA ============ -->
  <section class="section section-ink final">
    <div class="container center">
      <h2 class="display final-h" data-reveal>Ready to build<br /><span class="accent-head">what's next?</span></h2>
      <p class="final-sub dim" data-reveal>Your next stage of growth deserves better systems. Let's build them.</p>
      <div class="actions center-actions" data-reveal>
        <Button href={ctaPrimary.href} variant="brand" size="lg" arrow>Let's Talk Growth</Button>
        <Button href={ctaSecondary.href} variant="ghost" size="lg">Explore Our Services</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Shared editorial primitives ---------- */
  .display { font-family: var(--font-display); font-optical-sizing: auto; font-weight: 500; letter-spacing: -0.015em; }
  .kicker { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--brand-strong); margin-bottom: 1.4rem; }
  .kicker.accent { color: var(--brand-2); }
  .accent-head { color: var(--brand); }
  .muted-head { color: var(--text-faint); font-style: italic; font-weight: 400; }
  .text-link { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--brand-strong); }
  .text-link.accent { color: var(--brand-2); }
  .text-link :global(svg) { width: 18px; height: 18px; transition: transform .2s ease; }
  .text-link:hover :global(svg) { transform: translateX(4px); }
  .dim { color: var(--text-muted); }

  .section { padding-block: clamp(72px, 11vw, 160px); }
  .sect-h { font-size: clamp(2.4rem, 7vw, 5rem); line-height: 1.0; margin: 0; }
  .sect-intro { font-size: clamp(1.1rem, 2vw, 1.4rem); line-height: 1.55; max-width: 40ch; margin-top: 1.6rem; color: var(--text-muted); }

  /* Ink (near-black) sections for contrast */
  .section-ink { background: var(--ink); color: var(--on-dark); }
  .section-ink .sect-h, .section-ink .display { color: #fff; }
  .section-ink .dim { color: var(--on-dark-muted); }
  .section-ink .kicker { color: var(--brand-2); }
  .section-soft { background: var(--bg-alt); }

  /* ---------- 01 Hero ---------- */
  .hero { padding-block: clamp(90px, 15vw, 190px) clamp(40px, 7vw, 90px); }
  .hero-h { font-size: clamp(2.8rem, 9.5vw, 7.5rem); line-height: 0.95; margin: 0; max-width: 16ch; }
  .hero-sub { font-size: clamp(1.1rem, 2vw, 1.45rem); line-height: 1.55; max-width: 46ch; margin-top: 2rem; color: var(--text-muted); }
  .actions { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 2.6rem; align-items: center; }

  /* ---------- Marquee ---------- */
  .marquee { overflow: hidden; border-block: 1px solid var(--line); background: var(--surface); padding-block: 1rem; }
  .marquee-track { display: inline-flex; white-space: nowrap; animation: marquee 32s linear infinite; }
  .marquee-item { font-family: var(--font-display); font-size: clamp(1.2rem, 2.4vw, 1.9rem); font-weight: 500; letter-spacing: -0.01em; color: var(--text); padding-inline: 1.2rem; }
  .marquee-item i { color: var(--brand); font-style: normal; margin-left: 2.4rem; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  /* ---------- 02 Problem ---------- */
  .statements { margin-top: clamp(2.5rem, 6vw, 4.5rem); display: grid; gap: 0; }
  .statement { display: flex; gap: clamp(1rem, 3vw, 2.4rem); align-items: baseline; padding-block: clamp(1.3rem, 3vw, 2rem); border-top: 1px solid rgba(255,255,255,0.12); }
  .statement:last-child { border-bottom: 1px solid rgba(255,255,255,0.12); }
  .statement-n { font-size: clamp(1.4rem, 3vw, 2.1rem); color: var(--brand-2); flex-shrink: 0; width: 2.4ch; }
  .statement p { font-size: clamp(1.3rem, 3.4vw, 2.3rem); line-height: 1.15; margin: 0; }
  .statement strong { font-weight: 600; color: #fff; }
  .big-statement { margin-top: clamp(2.8rem, 6vw, 4.5rem); }
  .big-statement .display { font-size: clamp(1.8rem, 4.6vw, 3.4rem); line-height: 1.1; }
  .big-statement .aside { margin-top: 1.4rem; font-size: 1.1rem; color: var(--on-dark-muted); max-width: 46ch; }

  /* ---------- 03 What we do ---------- */
  .sect-intro { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .pillars { display: grid; gap: 0; }
  .pillar { display: grid; grid-template-columns: minmax(0, 0.4fr) minmax(0, 1fr); gap: clamp(1rem, 4vw, 3rem); padding-block: clamp(2rem, 4vw, 3.2rem); border-top: 1px solid var(--line); align-items: start; }
  .pillar:last-child { border-bottom: 1px solid var(--line); }
  .pillar.alt { grid-template-columns: minmax(0, 1fr) minmax(0, 0.4fr); }
  .pillar.alt .pillar-n { order: 2; text-align: right; }
  .pillar.alt .pillar-body { order: 1; }
  .pillar-n { font-size: clamp(3rem, 8vw, 6rem); line-height: 0.9; color: transparent; -webkit-text-stroke: 1.5px var(--line-strong); font-weight: 600; }
  .pillar-body h3 { font-size: clamp(1.6rem, 3.6vw, 2.6rem); line-height: 1.05; margin-bottom: 0.8rem; }
  .pillar-desc { font-size: 1.08rem; line-height: 1.6; color: var(--text-muted); max-width: 52ch; margin-bottom: 1.2rem; }
  .pillar-items { display: flex; flex-wrap: wrap; gap: 0.5rem 0.9rem; }
  .pillar-items li { font-size: 0.9rem; color: var(--text); padding: 0.3rem 0.8rem; border: 1px solid var(--line); border-radius: var(--r-pill); }
  .sect-foot { margin-top: clamp(2rem, 4vw, 3rem); }

  /* ---------- 04 Partnership / approach ---------- */
  .approach { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.4rem, 3vw, 2.4rem); margin-top: clamp(2.6rem, 6vw, 4.5rem); }
  .app-step { border-top: 2px solid rgba(255,255,255,0.18); padding-top: 1.2rem; }
  .approach.light .app-step { border-top-color: var(--line-strong); }
  .app-n { display: block; font-size: 1.1rem; color: var(--brand-2); margin-bottom: 1rem; font-weight: 600; }
  .approach.light .app-n { color: var(--brand-strong); }
  .app-step h3 { font-size: clamp(1.3rem, 2.4vw, 1.7rem); margin-bottom: 0.5rem; }
  .app-step p { font-size: 0.98rem; line-height: 1.55; }
  .guarantee { margin-top: clamp(3rem, 6vw, 5rem); max-width: 60ch; }
  .guarantee h3 { font-size: clamp(1.8rem, 4vw, 2.8rem); margin-bottom: 1rem; }
  .guarantee .actions { margin-top: 2rem; }

  /* ---------- 05 Offers ---------- */
  .offers { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(1rem, 2.5vw, 1.6rem); margin-top: clamp(2.6rem, 5vw, 4rem); }
  .offer { position: relative; border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(1.6rem, 3vw, 2.3rem); display: flex; flex-direction: column; background: var(--surface); }
  .offer.flagship { border-color: var(--ink); background: var(--ink); color: var(--on-dark); }
  .offer.flagship .offer-name, .offer.flagship .offer-price .display { color: #fff; }
  .offer.flagship .offer-who { color: var(--on-dark-muted); }
  .offer-flag { position: absolute; top: -0.7rem; left: clamp(1.6rem,3vw,2.3rem); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; background: var(--brand); padding: 0.3rem 0.8rem; border-radius: var(--r-pill); }
  .offer-name { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin-bottom: 1rem; }
  .offer-price { margin-bottom: 0.2rem; }
  .offer-price .display { font-size: clamp(1.8rem, 3.4vw, 2.5rem); font-weight: 600; }
  .offer-unit { font-size: 0.9rem; color: var(--text-muted); }
  .offer.flagship .offer-unit { color: var(--on-dark-muted); }
  .offer-rec { font-size: 0.95rem; color: var(--brand-strong); font-weight: 600; margin-bottom: 1.1rem; }
  .offer.flagship .offer-rec { color: var(--brand-2); }
  .offer-who { font-size: 0.98rem; line-height: 1.55; color: var(--text-muted); flex: 1; margin-bottom: 1.4rem; }
  .offer-cta { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--brand-strong); align-self: flex-start; }
  .offer.flagship .offer-cta { color: #fff; }
  .offer-cta :global(svg) { width: 17px; height: 17px; transition: transform .2s ease; }
  .offer-cta:hover :global(svg) { transform: translateX(4px); }
  .addons { margin-top: clamp(2.4rem, 4vw, 3.4rem); border-top: 1px solid var(--line); padding-top: 1.8rem; }
  .addons-label { display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 1rem; }
  .addons ul { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem 2rem; }
  .addons li { font-size: 0.95rem; color: var(--text-muted); padding-left: 1rem; position: relative; }
  .addons li::before { content: "—"; position: absolute; left: 0; color: var(--brand); }

  /* ---------- 06 Why + founder ---------- */
  .why-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 4.5rem); margin-top: clamp(2.6rem, 5vw, 4rem); align-items: start; }
  .why-copy p { font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.6; color: var(--text); max-width: 46ch; }
  .diff-list { display: grid; gap: 0.8rem; margin-top: 2rem; }
  .diff-list li { display: flex; align-items: flex-start; gap: 0.6rem; font-size: 1.02rem; color: var(--text); font-weight: 500; }
  .diff-list :global(svg) { width: 19px; height: 19px; color: var(--accent); flex-shrink: 0; margin-top: 3px; }
  .founder { border-left: 2px solid var(--ink); padding-left: clamp(1.4rem, 3vw, 2.4rem); }
  .founder-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-faint); }
  .founder-name { font-size: clamp(1.8rem, 4vw, 2.8rem); margin-top: 0.8rem; }
