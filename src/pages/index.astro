---
import Base from "@/layouts/Base.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import FinalCta from "@/components/FinalCta.astro";
import {
  site, services, process, values, ctaPrimary, ctaSecondary,
} from "@/data/site";
---
<Base
  title="HubIzi Schilderwerken · Schilder in Waalwijk"
  description={site.description}
  faqSchema
  serviceSchema
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
    </div>
    <div class="container hero-inner">
      <span class="hero-eyebrow" data-reveal>Schildersbedrijf uit Waalwijk · sinds 2017</span>
      <h1 data-reveal data-delay="80">
        Alles wat wij aanpakken,<br /><span class="gradient-text">tillen we naar een hoger niveau.</span>
      </h1>
      <p class="lead hero-sub" data-reveal data-delay="140">
        HubIzi Schilderwerken verzorgt binnen- en buitenschilderwerk, het spuiten van objecten
        en strak afwerkwerk. Vakwerk met een oog voor detail, netjes en zonder gedoe opgeleverd.
      </p>
      <div class="hero-actions" data-reveal data-delay="200">
        <Button href={ctaPrimary.href} variant="brand" size="lg" arrow>{ctaPrimary.label}</Button>
        <Button href={ctaSecondary.href} variant="ghost" size="lg">{ctaSecondary.label}</Button>
      </div>

      <div class="hero-trust" data-reveal data-delay="260">
        <div class="ht"><Icon name="check" /><div><strong>Oog voor detail</strong><span>de afwerking maakt het verschil</span></div></div>
        <div class="ht"><Icon name="check" /><div><strong>Vakwerk sinds 2017</strong><span>resultaat dat jaren meegaat</span></div></div>
        <div class="ht"><Icon name="check" /><div><strong>Netjes en schoon</strong><span>uw interieur blijft beschermd</span></div></div>
        <div class="ht"><Icon name="check" /><div><strong>Heldere offerte</strong><span>duidelijk en zonder verrassingen</span></div></div>
      </div>
    </div>
  </section>

  <!-- ============ DIENSTEN ============ -->
  <section class="section">
    <div class="container">
      <SectionHeading
        center
        eyebrow="Onze diensten"
        title="Vakwerk voor binnen en buiten"
        text="Van een frisse laag verf tot een naadloze spuitlaag en een strak afgewerkte muur. Alles onder één dak, met dezelfde aandacht voor detail."
      />
      <div class="grid grid-3 svc-grid">
        {services.map((s, i) => (
          <a href={`/diensten/${s.slug}/`} class="card card-hover svc-card" data-reveal data-delay={i * 80}>
            <span class="icon-chip"><Icon name={s.icon} /></span>
            <h3>{s.name}</h3>
            <p>{s.short}</p>
            <span class="svc-link">Lees meer <Icon name="arrow" class="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ WAAROM HUBIZI ============ -->
  <section class="section section-alt">
    <div class="container">
      <SectionHeading
        eyebrow="Waarom HubIzi"
        title="Netjes werk, van<br>voorbereiding tot oplevering"
        text="Een mooi eindresultaat begint met goed voorwerk en eindigt met een schone oplevering. Daar draait het bij ons om."
      />
      <div class="grid grid-4 val-grid">
        {values.map((v, i) => (
          <div class="val-card" data-reveal data-delay={i * 70}>
            <span class="icon-chip"><Icon name={v.icon} /></span>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ WERKWIJZE ============ -->
  <section class="section">
    <div class="container">
      <SectionHeading
        center
        eyebrow="Werkwijze"
        title="Van eerste gesprek tot strakke oplevering"
        text="Een heldere aanpak in vier stappen, zodat u altijd weet waar u aan toe bent."
      />
      <div class="grid grid-4 step-grid">
        {process.map((p, i) => (
          <div class="step-card" data-reveal data-delay={i * 70}>
            <span class="step-num">{p.step}</span>
            <h3>{p.name}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FOUNDER STRIP ============ -->
  <section class="section section-baby">
    <div class="container founder-strip">
      <div class="founder-quote" data-reveal>
        <span class="brand-stripes" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
        <p class="fq-text">"Een klus is pas af als het detail klopt. Dat is waar ik voor sta, bij elk project."</p>
        <p class="fq-name">{site.founder} · oprichter HubIzi Schilderwerken</p>
      </div>
      <div class="founder-actions" data-reveal data-delay="120">
        <Button href="/over-ons/" variant="primary" size="lg" arrow>Maak kennis met HubIzi</Button>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Veelgestelde vragen</span>
        <h2>Goed om te weten</h2>
      </div>
      <FaqAccordion />
    </div>
  </section>

  <FinalCta
    title="Klaar om uw woning<br>een frisse look te geven?"
    text="Vraag vrijblijvend een offerte aan. We komen graag langs om de klus samen te bekijken."
  />
</Base>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; padding-block: clamp(96px, 15vw, 190px) clamp(64px, 9vw, 120px); background: var(--grad-baby); }
  .hero-bg { position: absolute; inset: 0; pointer-events: none; }
  .hero-bg .orb { position: absolute; border-radius: 50%; filter: blur(70px); }
  .orb-1 { width: 460px; height: 460px; background: rgba(143,210,239,0.55); top: -140px; right: -100px; }
  .orb-2 { width: 380px; height: 380px; background: rgba(23,179,196,0.20); bottom: -160px; left: -80px; }
  .hero-inner { position: relative; z-index: 1; max-width: 900px; }
  .hero-eyebrow {
    display: inline-block; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--brand-strong);
    background: rgba(255,255,255,0.7); border: 1px solid var(--line-strong);
    padding: 7px 15px; border-radius: var(--r-pill);
  }
  .hero h1 { margin: 1.3rem 0 1.4rem; }
  .hero-sub { max-width: 62ch; }
  .hero-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 2.2rem; }
  .hero-trust {
    margin-top: clamp(2.5rem, 5vw, 3.6rem);
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem;
    padding-top: 2rem; border-top: 1px solid var(--line-strong);
  }
  .ht { display: flex; gap: 0.6rem; align-items: flex-start; }
  .ht :global(svg) { width: 20px; height: 20px; color: var(--brand); flex-shrink: 0; margin-top: 3px; }
  .ht strong { display: block; color: var(--text); font-size: 0.98rem; }
  .ht span { display: block; color: var(--text-muted); font-size: 0.88rem; }
  @media (max-width: 820px) { .hero-trust { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .hero-trust { grid-template-columns: 1fr; } }

  /* DIENSTEN */
  .svc-grid { margin-top: clamp(2rem, 4vw, 3rem); }
  .svc-card { display: flex; flex-direction: column; align-items: flex-start; }
  .svc-card h3 { margin: 1.1rem 0 0.6rem; }
  .svc-card p { flex: 1; }
  .svc-link { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 1.2rem; color: var(--brand-strong); font-weight: 600; font-size: 0.95rem; }
  .svc-link :global(svg) { width: 17px; height: 17px; transition: transform 0.2s ease; }
  .svc-card:hover .svc-link :global(svg) { transform: translateX(3px); }

  /* WAARDEN */
  .val-grid { margin-top: clamp(2rem, 4vw, 3rem); }
  .val-card h3 { margin: 1rem 0 0.55rem; font-size: 1.2rem; }
  .val-card p { font-size: 0.96rem; }

  /* WERKWIJZE */
  .step-grid { margin-top: clamp(2rem, 4vw, 3rem); }
  .step-card { position: relative; padding: 1.6rem; border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); }
  .step-num {
    display: inline-grid; place-items: center; width: 46px; height: 46px;
    border-radius: 13px; background: var(--grad-brand); color: #fff;
    font-weight: 700; font-size: 1.05rem; margin-bottom: 1rem;
  }
  .step-card h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }
  .step-card p { font-size: 0.95rem; }

  /* FOUNDER */
  .founder-strip { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .founder-quote { max-width: 640px; }
  .founder-quote .brand-stripes { margin-bottom: 1.4rem; }
  .fq-text { font-size: clamp(1.4rem, 2.6vw, 2rem); line-height: 1.35; color: var(--text); font-weight: 500; letter-spacing: -0.01em; }
  .fq-name { margin-top: 1.1rem; font-size: 0.95rem; font-weight: 600; color: var(--brand-strong); }
</style>
