---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import { site } from "@/data/site";
import { getCollection } from "astro:content";

const articles = (await getCollection("gids")).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Gids & kennisbank",
  description: "Antwoorden op echte vragen van ondernemers over websites, leadgeneratie, AI-automatisering en groei.",
  url: `${site.url}/gids/`,
  isPartOf: { "@id": `${site.url}/#website` },
};
---
<Base
  lang="nl"
  title="Gids & kennisbank · websites, leadgeneratie & AI-automatisering | Webmaister"
  description="Praktische antwoorden op echte ondernemersvragen: wat kost een website, wat is GEO, website of leadgeneratiesysteem, en meer. De kennisbank van Webmaister."
>
  <section class="page-hero">
    <div class="container center" style="max-width:780px">
      <span class="eyebrow" data-reveal>Gids</span>
      <h1 data-reveal data-delay="60">Antwoorden op <span class="gradient-text">echte vragen.</span></h1>
      <p class="lead" data-reveal data-delay="120" style="margin:1.4rem auto 0;max-width:600px">
        Praktische artikelen over websites, leadgeneratie, AI-automatisering en groei, geschreven om je echt verder te helpen.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:820px">
      <ul class="gids-list">
        {articles.map((a) => (
          <li class="gids-item" data-reveal>
            <a href={`/gids/${a.id}/`}>
              <h2>{a.data.title}</h2>
              <p>{a.data.description}</p>
              <span class="gids-link">Lees het artikel <Icon name="arrow" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>

<style>
  .page-hero { padding-block: clamp(60px, 9vw, 120px) clamp(40px, 6vw, 70px); background: var(--grad-soft); border-bottom: 1px solid var(--line); }
  .gids-list { display: grid; gap: 0; }
  .gids-item { border-top: 1px solid var(--line); }
  .gids-item:last-child { border-bottom: 1px solid var(--line); }
  .gids-item a { display: block; padding-block: clamp(1.6rem, 3vw, 2.2rem); transition: padding-left .25s ease; }
  .gids-item a:hover { padding-left: 0.8rem; }
  .gids-item h2 { font-size: clamp(1.3rem, 3vw, 1.9rem); line-height: 1.2; margin-bottom: 0.5rem; }
  .gids-item p { color: var(--text-muted); line-height: 1.6; max-width: 64ch; margin-bottom: 0.8rem; }
  .gids-link { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--brand-strong); font-weight: 600; font-size: 0.95rem; }
  .gids-link :global(svg) { width: 16px; height: 16px; transition: transform .2s ease; }
  .gids-item a:hover .gids-link :global(svg) { transform: translateX(4px); }
</style>
