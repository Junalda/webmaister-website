---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { startOptions } from "@/data/site";
---
<Base
  title="Start here · What do you need help with?"
  description="Tell us what you need and we'll point you to the right solution: a new website from €500, a full website upgrade from €2.700, or a growth partnership from €1.600/month. Message us on WhatsApp."
>
  <section class="start-hero">
    <div class="container center" style="max-width:760px">
      <span class="eyebrow" data-reveal>Webmaister</span>
      <h1 data-reveal data-delay="60">What do you need help with?</h1>
      <p class="lead" data-reveal data-delay="120" style="margin:1.2rem auto 0;max-width:520px">
        Pick what fits you best. We'll show you exactly how we can help, and you can message us right away.
      </p>
    </div>
  </section>

  <section class="start-body">
    <div class="container" style="max-width:760px">
      <div class="choices">
        {startOptions.map((o, i) => (
          <a class="choice" href={`/start/${o.slug}/`} data-reveal data-delay={i * 70}>
            <span class="choice-text">
              <span class="choice-title">{o.choice}</span>
              <span class="choice-price">{o.priceLine}</span>
              <span class="choice-tag">{o.tagline}</span>
            </span>
            <span class="choice-arrow"><Icon name="arrow" /></span>
          </a>
        ))}
      </div>

      <div class="start-cta" data-reveal>
        <p class="start-cta-note">Not sure which one fits? Just ask us.</p>
        <WhatsAppButton label="WhatsApp us" />
      </div>
    </div>
  </section>
</Base>

<style>
  .start-hero { padding-block: clamp(56px, 9vw, 110px) clamp(24px, 4vw, 40px); background: var(--grad-soft); border-bottom: 1px solid var(--line); }
  .start-body { padding-block: clamp(36px, 6vw, 64px) clamp(64px, 9vw, 120px); }

  .choices { display: flex; flex-direction: column; gap: 1rem; }
  .choice {
    display: flex; align-items: center; gap: 1rem;
    padding: clamp(1.3rem, 3vw, 1.7rem) clamp(1.3rem, 3vw, 1.9rem);
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .choice:hover { transform: translateY(-3px); border-color: var(--brand); box-shadow: var(--shadow-md); }
  .choice-text { display: flex; flex-direction: column; gap: 0.35rem; flex: 1; }
  .choice-title { font-size: clamp(1.15rem, 2.4vw, 1.4rem); font-weight: 600; letter-spacing: -0.01em; color: var(--text); line-height: 1.2; }
  .choice-price { font-size: 0.95rem; font-weight: 600; color: var(--brand-strong); }
  .choice-tag { font-size: 0.9rem; color: var(--text-muted); }
  .choice-arrow {
    display: grid; place-items: center; width: 44px; height: 44px; flex-shrink: 0;
    border-radius: 50%; background: var(--bg-tint); color: var(--brand-strong);
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
  }
  .choice-arrow :global(svg) { width: 20px; height: 20px; }
  .choice:hover .choice-arrow { background: var(--brand); color: #fff; transform: translateX(3px); }

  .start-cta { margin-top: clamp(2.4rem, 5vw, 3.4rem); text-align: center; }
  .start-cta-note { color: var(--text-muted); margin-bottom: 1rem; font-size: 0.98rem; }
</style>
