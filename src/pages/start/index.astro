---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import Button from "@/components/Button.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import { startOptions, problems, framework, pillars, solutionsFaqs } from "@/data/site";

const pains = problems.slice(0, 4);
---
<Base
  title="Start here · What do you need help with?"
  description="Tell us what you need and we'll point you to the right solution: a new website from €500, a full website upgrade from €2.700, or a growth partnership from €1.600/month. Message us on WhatsApp."
>
  <!-- 01 · HERO -->
  <section class="s-hero">
    <div class="container hero-wrap">
      <div class="hero-text">
        <p class="kicker" data-reveal><span class="kicker-rule"></span>Start here</p>
        <h1 class="disp hero-h" data-reveal data-delay="60">More customers.<br /><span class="hl">Less manual work.</span></h1>
        <p class="hero-sub" data-reveal data-delay="120">
          Webmaister builds websites, lead generation and AI automation for growing businesses in
          Rotterdam and beyond. Tell us where you are, and we'll show you the right next step.
        </p>
        <div class="hero-actions" data-reveal data-delay="180">
          <Button href="#offer" variant="brand" size="lg" arrow>See what you need</Button>
          <WhatsAppButton label="WhatsApp us" />
        </div>
      </div>
      <div class="hero-photo" data-reveal data-delay="120">
        <img src="/junalda.jpg" alt="Junalda Meiland, founder of Webmaister, in Rotterdam" width="1717" height="2576" fetchpriority="high" />
        <span class="float-pill fp-1"><i></i> Websites</span>
        <span class="float-pill fp-2"><i></i> Lead generation</span>
        <span class="float-pill fp-3"><i></i> AI automation</span>
      </div>
    </div>
  </section>

  <!-- 02 · THE PROBLEM -->
  <section class="section s-problem">
    <div class="container" style="max-width:980px">
      <p class="kicker" data-reveal><span class="kicker-rule"></span>Sound familiar?</p>
      <h2 class="disp s-h" data-reveal data-delay="60">The gap most businesses<br />get stuck in.</h2>
      <ol class="pain-list" data-reveal data-delay="120">
        {pains.map((p, i) => (
          <li class="pain">
            <span class="pain-n disp">{String(i + 1).padStart(2, "0")}</span>
            <div class="pain-body">
              <h3 class="disp">{p.title}</h3>
              <p>{p.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="pain-punch disp" data-reveal>
        Most businesses don't have a marketing problem.
        <span class="hl">They have a systems problem.</span>
      </p>
    </div>
  </section>

  <!-- 03 · MEET THE FOUNDER -->
  <section class="section section-alt s-founder">
    <div class="container" style="max-width:820px">
      <p class="kicker" data-reveal><span class="kicker-rule"></span>Meet the founder</p>
      <h2 class="disp s-h" data-reveal data-delay="60">Hi, I'm Junalda.</h2>
      <p class="f-role" data-reveal data-delay="90">Founder of Webmaister · Rotterdam</p>
      <div class="f-copy" data-reveal data-delay="120">
        <p>I bring 10+ years in technology, a background in software development and IT project management, and hands-on experience building and running businesses as an entrepreneur since 2016. That combination, technology and business together, is how I approach growth at Webmaister.</p>
        <p>We don't start with design. We start with understanding where your business wants to go, then build the website, systems and automation to take it there, so you get more customers, less manual work, and a foundation built to scale.</p>
      </div>
    </div>
  </section>

  <!-- 04 · THE METHOD -->
  <section class="section s-method">
    <div class="container" style="max-width:1000px">
      <p class="kicker" data-reveal><span class="kicker-rule"></span>How we work</p>
      <h2 class="disp s-h" data-reveal data-delay="60">A simple, proven method.</h2>
      <div class="method-steps" data-reveal data-delay="120">
        {framework.map((f) => (
          <div class="m-step">
            <span class="m-n disp">{f.step}</span>
            <h3 class="disp">{f.name}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 04b · WHAT YOU WALK AWAY WITH -->
  <section class="section section-alt s-deliver">
    <div class="container" style="max-width:1040px">
      <p class="kicker" data-reveal><span class="kicker-rule"></span>What you walk away with</p>
      <h2 class="disp s-h" data-reveal data-delay="60">More than a website.</h2>
      <div class="deliver-grid" data-reveal data-delay="120">
        {pillars.map((p) => (
          <article class="deliver-card">
            <span class="deliver-badge"><Icon name="check" /> What you get</span>
            <span class="deliver-label">{p.name}</span>
            <h3 class="disp">{p.short}</h3>
            <p>{p.outcome}</p>
          </article>
        ))}
      </div>
      <p class="deliver-note" data-reveal>Typical delivery: <strong>2 to 4 weeks</strong>, depending on scope.</p>
    </div>
  </section>

  <!-- 05 · THE OFFER -->
  <section class="section s-offer" id="offer">
    <div class="container" style="max-width:940px">
      <p class="kicker" data-reveal><span class="kicker-rule"></span>The offer</p>
      <h2 class="disp s-h" data-reveal data-delay="60">What do you need help with?</h2>
      <p class="offer-lead" data-reveal data-delay="100">
        Pick what fits you best. We'll show you exactly how we can help, and you can message us right away.
      </p>

      <ol class="choices">
        {startOptions.map((o, i) => (
          <li class="choice-row" data-reveal>
            <a href={`/start/${o.slug}/`} class="choice-link">
              <span class="choice-n disp">{String(i + 1).padStart(2, "0")}</span>
              <span class="choice-main">
                <span class="choice-title disp">{o.choice}</span>
                {o.priceLine && <span class="choice-price">{o.priceLine}</span>}
                <span class="choice-benefit">{o.benefit}</span>
              </span>
              <span class="choice-go">Choose <Icon name="arrow" /></span>
            </a>
          </li>
        ))}
      </ol>

    </div>
  </section>

  <!-- 06 · THE MATH -->
  <section class="section section-alt s-math">
    <div class="container" style="max-width:820px">
      <p class="kicker" data-reveal><span class="kicker-rule"></span>Worth it?</p>
      <h2 class="disp s-h" data-reveal data-delay="60">The math is simple.</h2>
      <p class="math-lead" data-reveal data-delay="100">
        What's one new customer worth to you? For most businesses, it's more than the price of a
        starter website. We build toward a foundation that pays for itself, and then keeps paying.
      </p>
      <ul class="math-points" data-reveal data-delay="120">
        <li><span class="mp-k disp">From €500</span><span class="mp-v">A professional one-page website, live in 2 to 4 weeks.</span></li>
        <li><span class="mp-k disp">Built to convert</span><span class="mp-v">The goal is customers and qualified leads, not just clicks.</span></li>
        <li><span class="mp-k disp">Hours back</span><span class="mp-v">Automation takes repetitive work off your plate, week after week.</span></li>
      </ul>
    </div>
  </section>

  <!-- 07 · FAQ -->
  <section class="section s-faq">
    <div class="container" style="max-width:860px">
      <p class="kicker center-k" data-reveal><span class="kicker-rule"></span>Got questions?</p>
      <h2 class="disp s-h center-h" data-reveal data-delay="60">The things people ask first.</h2>
      <div class="faq-wrap" data-reveal data-delay="120">
        <FaqAccordion items={solutionsFaqs} />
      </div>
    </div>
  </section>

  <!-- 08 · FINAL CTA -->
  <section class="section section-alt s-final">
    <div class="container center" style="max-width:720px">
      <h2 class="disp s-h" data-reveal>Not sure which one fits?</h2>
      <p class="final-sub" data-reveal data-delay="80">Tell us where your business stands and we'll point you to the right next step. No pressure.</p>
      <div class="final-actions" data-reveal data-delay="140">
        <WhatsAppButton label="WhatsApp us" />
        <Button href="/contact/" variant="brand" size="lg" arrow>Book a call</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  /* A founder-led, story-first /start that mirrors the reference structure
     (hero → problem → founder → method → offer), in Webmaister's own light,
     fresh palette with a calm classic serif. All copy is drawn from the site's
     existing content (positioning, problems, framework, founder bio) and the
     real founder photo (no invented facts or figures). */
  .disp { font-family: Georgia, "Times New Roman", serif; font-weight: 500; letter-spacing: -0.012em; }

  .kicker { display: inline-flex; align-items: center; gap: 0.8rem; font-size: 0.76rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--brand); margin-bottom: 1.5rem; }
  .kicker-rule { width: 30px; height: 1.5px; background: var(--grad-brand); display: inline-block; border-radius: 2px; }

  .s-h { font-size: clamp(2.1rem, 5vw, 3.6rem); line-height: 1.05; margin: 0; color: var(--ink); font-weight: 400; }
  .hl { font-style: italic; font-weight: 400; color: var(--brand-strong); background: linear-gradient(180deg, transparent 58%, #cfe8fb 58%); padding-inline: 0.1em; border-radius: 3px; }

  /* ---- 01 Hero ---- */
  .s-hero { padding-block: clamp(64px, 10vw, 130px) clamp(56px, 9vw, 110px); background: var(--grad-soft); border-bottom: 1px solid var(--line); }
  .hero-wrap { display: grid; grid-template-columns: 1.08fr 0.92fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .hero-h { font-size: clamp(2.8rem, 7vw, 5.2rem); line-height: 0.98; margin: 0; color: var(--ink); font-weight: 400; }
  .hero-sub { margin-top: 1.8rem; font-size: clamp(1.08rem, 1.8vw, 1.3rem); line-height: 1.65; color: var(--text-muted); max-width: 46ch; }
  .hero-actions { display: flex; gap: 0.9rem; flex-wrap: wrap; align-items: center; margin-top: 2.4rem; }

  .hero-photo { position: relative; }
  .hero-photo::before { content: ""; position: absolute; inset: auto -16px -16px auto; width: 74%; height: 74%; background: var(--bg-tint); border-radius: var(--r-xl); z-index: 0; }
  .hero-photo img { position: relative; z-index: 1; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: center 20%; border-radius: var(--r-xl); box-shadow: var(--shadow-lg); }
  .float-pill { position: absolute; z-index: 2; display: inline-flex; align-items: center; gap: 0.5rem; background: var(--surface); color: var(--ink); font-size: 0.86rem; font-weight: 600; padding: 0.55rem 0.95rem; border-radius: var(--r-pill); box-shadow: var(--shadow-md); border: 1px solid var(--line); }
  .float-pill i { width: 8px; height: 8px; border-radius: 50%; background: var(--grad-brand); flex-shrink: 0; }
  .fp-1 { top: 8%; left: -6%; }
  .fp-2 { top: 44%; right: -8%; }
  .fp-3 { bottom: 9%; left: -4%; }

  /* ---- 02 Problem ---- */
  .pain-list { list-style: none; padding: 0; margin: clamp(2.2rem, 4.5vw, 3.4rem) 0 0; display: grid; gap: 0; }
  .pain { display: grid; grid-template-columns: auto 1fr; gap: clamp(1rem, 3vw, 2.2rem); align-items: start; padding-block: clamp(1.4rem, 3vw, 2rem); border-top: 1px solid var(--line); }
  .pain:last-of-type { border-bottom: 1px solid var(--line); }
  .pain-n { font-size: clamp(1.2rem, 2.6vw, 1.8rem); color: var(--brand); font-weight: 500; line-height: 1; padding-top: 0.2rem; font-variant-numeric: tabular-nums; }
  .pain-body h3 { font-size: clamp(1.3rem, 2.8vw, 1.9rem); line-height: 1.1; margin-bottom: 0.45rem; color: var(--ink); font-weight: 400; }
  .pain-body p { font-size: 1.02rem; line-height: 1.6; color: var(--text-muted); max-width: 60ch; }
  .pain-punch { margin-top: clamp(2.2rem, 4.5vw, 3.2rem); font-size: clamp(1.5rem, 3.4vw, 2.4rem); line-height: 1.2; color: var(--ink); font-weight: 400; max-width: 24ch; }

  /* ---- 03 Founder ---- */
  .s-founder .f-role { margin-top: 1rem; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--brand-strong); }
  .f-copy { margin-top: 1.6rem; }
  .f-copy p { font-size: clamp(1.1rem, 2vw, 1.3rem); line-height: 1.7; color: var(--text); }
  .f-copy p + p { margin-top: 1.2rem; }

  /* ---- 04 Method ---- */
  .method-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.2rem, 3vw, 2.2rem); margin-top: clamp(2.4rem, 5vw, 3.4rem); }
  .m-step { border-top: 2px solid var(--line-strong); padding-top: 1.1rem; }
  .m-n { display: block; font-size: 1rem; font-weight: 600; color: var(--brand-strong); margin-bottom: 0.7rem; font-variant-numeric: tabular-nums; }
  .m-step h3 { font-size: clamp(1.2rem, 2.2vw, 1.55rem); margin-bottom: 0.45rem; color: var(--ink); font-weight: 500; }
  .m-step p { font-size: 0.98rem; line-height: 1.6; color: var(--text-muted); }

  /* ---- 05 Offer ---- */
  .offer-lead { font-size: clamp(1.08rem, 1.8vw, 1.3rem); line-height: 1.6; color: var(--text-muted); max-width: 46ch; margin-top: 1.2rem; }
  .choices { display: grid; gap: 0; list-style: none; padding: 0; margin: clamp(2rem, 4vw, 3rem) 0 0; }
  .choice-row { border-top: 1px solid var(--line); }
  .choice-row:last-child { border-bottom: 1px solid var(--line); }
  .choice-link {
    position: relative;
    display: grid; grid-template-columns: auto 1fr auto; align-items: center;
    gap: clamp(1.1rem, 4vw, 3rem); padding-block: clamp(1.7rem, 3.6vw, 2.6rem);
    padding-inline: clamp(0.4rem, 1.5vw, 1.2rem);
    transition: background 0.4s ease, padding-left 0.35s ease;
  }
  .choice-link::after {
    content: ""; position: absolute; left: 0; bottom: -1px; height: 2px; width: 0;
    background: var(--grad-brand); border-radius: 2px;
    transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .choice-link:hover { background: var(--bg-tint); padding-left: clamp(1rem, 2.5vw, 1.8rem); }
  .choice-link:hover::after { width: 100%; }
  .choice-n { font-size: clamp(1rem, 2.2vw, 1.3rem); line-height: 1; color: var(--text-faint); font-weight: 500; letter-spacing: 0.05em; align-self: start; padding-top: 0.5rem; font-variant-numeric: tabular-nums; }
  .choice-link:hover .choice-n { color: var(--brand-strong); }
  .choice-main { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
  .choice-title { font-size: clamp(1.4rem, 3.4vw, 2.3rem); line-height: 1.08; color: var(--ink); font-weight: 400; }
  .choice-price { font-size: 0.82rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--brand-strong); }
  .choice-benefit { font-size: 1.02rem; line-height: 1.5; color: var(--text-muted); max-width: 52ch; }
  .choice-go { display: inline-flex; align-items: center; gap: 0.55rem; font-weight: 600; font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); white-space: nowrap; }
  .choice-go :global(svg) { width: 16px; height: 16px; transition: transform 0.3s ease; }
  .choice-link:hover .choice-go { color: var(--brand-strong); }
  .choice-link:hover .choice-go :global(svg) { transform: translateX(6px); }

  /* ---- 04b Deliverables ---- */
  .deliver-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2.4vw, 1.6rem); margin-top: clamp(2.4rem, 5vw, 3.4rem); }
  .deliver-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(1.6rem, 3vw, 2.1rem); display: flex; flex-direction: column; }
  .deliver-badge { display: inline-flex; align-items: center; gap: 0.4rem; align-self: flex-start; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--brand-strong); background: var(--bg-tint); padding: 0.32rem 0.7rem; border-radius: var(--r-pill); margin-bottom: 1.1rem; }
  .deliver-badge :global(svg) { width: 13px; height: 13px; }
  .deliver-label { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 0.5rem; }
  .deliver-card h3 { font-size: clamp(1.2rem, 2.2vw, 1.5rem); line-height: 1.2; margin-bottom: 0.7rem; color: var(--ink); font-weight: 500; }
  .deliver-card p { font-size: 0.98rem; line-height: 1.6; color: var(--text-muted); }
  .deliver-note { margin-top: clamp(1.8rem, 3vw, 2.4rem); font-size: 0.95rem; color: var(--text-muted); }
  .deliver-note strong { color: var(--ink); }

  /* ---- 06 The math ---- */
  .math-lead { margin-top: clamp(1.2rem, 2.5vw, 1.8rem); font-size: clamp(1.1rem, 2vw, 1.3rem); line-height: 1.65; color: var(--text); max-width: 52ch; }
  .math-points { list-style: none; padding: 0; margin: clamp(2rem, 4vw, 2.8rem) 0 0; display: grid; gap: 0; }
  .math-points li { display: grid; grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr); gap: clamp(0.8rem, 3vw, 2rem); align-items: baseline; padding-block: clamp(1.1rem, 2.4vw, 1.5rem); border-top: 1px solid var(--line); }
  .math-points li:last-child { border-bottom: 1px solid var(--line); }
  .mp-k { font-size: clamp(1.15rem, 2.4vw, 1.6rem); color: var(--brand-strong); font-weight: 500; line-height: 1.1; }
  .mp-v { font-size: 1.02rem; line-height: 1.55; color: var(--text-muted); }

  /* ---- 07 FAQ ---- */
  .center-k { justify-content: center; width: 100%; }
  .center-h { text-align: center; }
  .s-faq .center-k { display: flex; }
  .faq-wrap { margin-top: clamp(2.2rem, 4.5vw, 3.2rem); }

  /* ---- 08 Final CTA ---- */
  .final-sub { font-size: clamp(1.05rem, 1.8vw, 1.25rem); line-height: 1.6; color: var(--text-muted); margin: 1.2rem auto 0; max-width: 46ch; }
  .final-actions { display: flex; gap: 0.9rem; flex-wrap: wrap; align-items: center; justify-content: center; margin-top: 2rem; }

  @media (max-width: 860px) {
    .deliver-grid { grid-template-columns: 1fr; }
    .hero-wrap { grid-template-columns: 1fr; gap: 2.6rem; }
    .hero-photo { max-width: 400px; margin-inline: auto; }
    .method-steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 620px) {
    .method-steps { grid-template-columns: 1fr; }
    .math-points li { grid-template-columns: 1fr; gap: 0.25rem; }
    .pain { grid-template-columns: 1fr; gap: 0.3rem; }
    .choice-link { grid-template-columns: auto 1fr; gap: 1rem 1.2rem; }
    .choice-go { grid-column: 2; justify-self: start; margin-top: 0.6rem; }
    .fp-2 { right: 0; }
    .fp-1, .fp-3 { left: 0; }
  }
</style>
