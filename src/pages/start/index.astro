---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import Button from "@/components/Button.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { startOptions } from "@/data/site";
---
<Base
  title="Start here · What do you need help with?"
  description="Tell us what you need and we'll point you to the right solution: a new website from €500, a full website upgrade from €2.700, or a growth partnership from €1.600/month. Message us on WhatsApp."
>
  <section class="start-hero">
    <div class="container" style="max-width:900px">
      <p class="kicker" data-reveal>Start here</p>
      <h1 class="disp start-h" data-reveal data-delay="60">What do you<br />need help with?</h1>
      <p class="start-lead" data-reveal data-delay="120">
        Pick what fits you best. We'll show you exactly how we can help, and you can message us right away.
      </p>
    </div>
  </section>

  <section class="start-body">
    <div class="container" style="max-width:900px">
      <ol class="choices">
        {startOptions.map((o, i) => (
          <li class="choice-row" data-reveal>
            <a href={`/start/${o.slug}/`} class="choice-link">
              <span class="choice-n disp">0{i + 1}</span>
              <span class="choice-main">
                <span class="choice-title disp">{o.choice}</span>
                <span class="choice-meta">
                  <span class="choice-price">{o.priceLine}</span>
                  <span class="choice-tag">{o.tagline}</span>
                </span>
              </span>
              <span class="choice-go">Choose <Icon name="arrow" /></span>
            </a>
          </li>
        ))}
      </ol>

      <div class="start-cta" data-reveal>
        <p class="start-cta-note disp">Not sure which one fits?</p>
        <div class="start-cta-actions">
          <WhatsAppButton label="WhatsApp us" />
          <Button href="/contact/" variant="ghost" size="lg">Book a call</Button>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .disp { font-family: var(--font-display); font-optical-sizing: auto; font-weight: 500; letter-spacing: -0.015em; }
  .kicker { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--brand-strong); margin-bottom: 1.4rem; }

  .start-hero { padding-block: clamp(80px, 13vw, 160px) clamp(20px, 4vw, 40px); }
  .start-h { font-size: clamp(2.6rem, 8vw, 5.5rem); line-height: 0.98; margin: 0; }
  .start-lead { font-size: clamp(1.1rem, 2vw, 1.4rem); line-height: 1.55; color: var(--text-muted); max-width: 44ch; margin-top: 1.8rem; }

  .start-body { padding-block: clamp(32px, 6vw, 56px) clamp(72px, 10vw, 140px); }
  .choices { display: grid; gap: 0; list-style: none; padding: 0; margin: 0; }
  .choice-row { border-top: 1px solid var(--line); }
  .choice-row:last-child { border-bottom: 1px solid var(--line); }
  .choice-link {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center;
    gap: clamp(1rem, 4vw, 2.6rem); padding-block: clamp(1.6rem, 4vw, 2.6rem);
    transition: padding-left 0.25s ease;
  }
  .choice-link:hover { padding-left: 0.8rem; }
  .choice-n { font-size: clamp(1.6rem, 4vw, 2.6rem); line-height: 1; color: transparent; -webkit-text-stroke: 1.5px var(--line-strong); font-weight: 600; }
  .choice-link:hover .choice-n { -webkit-text-stroke-color: var(--brand); }
  .choice-main { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
  .choice-title { font-size: clamp(1.5rem, 4vw, 2.6rem); line-height: 1.05; color: var(--text); }
  .choice-meta { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; align-items: baseline; }
  .choice-price { font-size: 1rem; font-weight: 700; color: var(--brand-strong); }
  .choice-tag { font-size: 0.95rem; color: var(--text-muted); }
  .choice-go { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; font-size: 0.95rem; color: var(--text); white-space: nowrap; }
  .choice-go :global(svg) { width: 18px; height: 18px; transition: transform 0.2s ease; }
  .choice-link:hover .choice-go { color: var(--brand-strong); }
  .choice-link:hover .choice-go :global(svg) { transform: translateX(5px); }

  .start-cta { margin-top: clamp(3rem, 6vw, 4.5rem); }
  .start-cta-note { font-size: clamp(1.5rem, 3.4vw, 2.2rem); margin-bottom: 1.4rem; color: var(--text); }
  .start-cta-actions { display: flex; gap: 0.9rem; flex-wrap: wrap; align-items: center; }

  @media (max-width: 620px) {
    .choice-link { grid-template-columns: auto 1fr; gap: 1rem; }
    .choice-go { grid-column: 2; justify-self: start; margin-top: 0.4rem; }
  }
</style>
