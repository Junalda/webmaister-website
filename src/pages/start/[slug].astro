---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import Button from "@/components/Button.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { startOptions } from "@/data/site";

export function getStaticPaths() {
  return startOptions.map((o) => ({ params: { slug: o.slug }, props: { o } }));
}
const { o } = Astro.props;
---
<Base title={o.title} description={o.description}>
  <section class="opt-hero">
    <div class="container" style="max-width:720px">
      <a class="opt-back" href="/start/"><Icon name="arrow" /> All options</a>
      <span class="eyebrow" data-reveal>Webmaister</span>
      <h1 data-reveal data-delay="60">{o.choice}</h1>
      <p class="lead" data-reveal data-delay="120" style="margin:1.2rem 0 0">{o.lead}</p>
      <div class="opt-price" data-reveal data-delay="180">
        <span class="opt-price-value">{o.price}</span>
        <span class="opt-price-note">{o.priceNote}</span>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container" style="max-width:720px">
      <div class="opt-grid">
        <div class="opt-block" data-reveal>
          <span class="opt-label">Who it's for</span>
          <p>{o.forText}</p>
        </div>
        <div class="opt-block card opt-includes" data-reveal>
          <span class="opt-label">What you get</span>
          <ul>
            {o.includes.map((item) => (
              <li><Icon name="check" /> <span>{item}</span></li>
            ))}
          </ul>
        </div>
      </div>

      <div class="opt-cta" data-reveal>
        <h2>Ready, or have a question?</h2>
        <p>Message us on WhatsApp for a quick answer, or book a free call to talk it through.</p>
        <div class="opt-cta-actions">
          <WhatsAppButton label="WhatsApp us" />
          <Button href="/contact/" variant="ghost" size="lg">Book a free call</Button>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .opt-hero { padding-block: clamp(48px, 8vw, 96px) clamp(24px, 4vw, 40px); background: var(--grad-soft); border-bottom: 1px solid var(--line); }
  .opt-back { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; font-weight: 560; color: var(--text-muted); margin-bottom: 1.4rem; transition: color 0.2s ease; }
  .opt-back :global(svg) { width: 16px; height: 16px; transform: rotate(180deg); }
  .opt-back:hover { color: var(--brand-strong); }
  .opt-price { display: inline-flex; align-items: baseline; gap: 0.6rem; margin-top: 1.8rem; padding: 0.7rem 1.2rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-pill); }
  .opt-price-value { font-size: 1.4rem; font-weight: 650; color: var(--text); letter-spacing: -0.01em; }
  .opt-price-note { font-size: 0.85rem; color: var(--text-muted); }

  .opt-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.4rem, 3vw, 2.4rem); align-items: start; }
  .opt-label { display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--brand-strong); margin-bottom: 0.8rem; }
  .opt-block p { font-size: 1.02rem; line-height: 1.65; color: var(--text-muted); }
  .opt-includes { align-self: stretch; }
  .opt-includes ul { display: grid; gap: 0.7rem; }
  .opt-includes li { display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.98rem; color: var(--text); font-weight: 500; }
  .opt-includes :global(svg) { width: 18px; height: 18px; color: var(--accent); flex-shrink: 0; margin-top: 3px; }

  .opt-cta { margin-top: clamp(2.6rem, 5vw, 3.6rem); text-align: center; }
  .opt-cta h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .opt-cta p { margin: 0.8rem auto 1.8rem; max-width: 460px; color: var(--text-muted); }
  .opt-cta-actions { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; align-items: center; }

  @media (max-width: 680px) {
    .opt-grid { grid-template-columns: 1fr; }
  }
</style>
