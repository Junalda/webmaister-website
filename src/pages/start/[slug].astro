---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import Button from "@/components/Button.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { startOptions } from "@/data/site";

export function getStaticPaths() {
  return startOptions.map((o) => ({ params: { slug: o.slug }, props: { o } }));
}
const { o } = Astro.props;
---
<Base title={o.title} description={o.description}>
  <section class="opt-hero">
    <div class="container" style="max-width:820px">
      <a class="opt-back" href="/start/"><Icon name="arrow" /> All options</a>
      <p class="kicker" data-reveal>{o.service}</p>
      <h1 class="disp opt-h" data-reveal data-delay="60">{o.choice}</h1>
      <p class="opt-lead" data-reveal data-delay="120">{o.lead}</p>
      {o.price && (
        <div class="opt-price" data-reveal data-delay="180">
          <span class="opt-price-value disp">{o.price}</span>
          <span class="opt-price-note">{o.priceNote}</span>
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:820px">
      <div class="opt-grid">
        <div class="opt-block" data-reveal>
          <span class="opt-label">Who it's for</span>
          <p>{o.forText}</p>
        </div>
        <div class="opt-block" data-reveal>
          <span class="opt-label">The problem it solves</span>
          <p>{o.problem}</p>
        </div>
      </div>

      <div class="opt-includes-wrap" data-reveal>
        <span class="opt-label">{o.price ? "What's included" : "How it works"}</span>
        <ul class="opt-includes">
          {o.includes.map((item) => (
            <li><Icon name="check" /> <span>{item}</span></li>
          ))}
        </ul>
        {o.note && <p class="opt-note">{o.note}</p>}
      </div>

      <div class="opt-cta section-ink" data-reveal>
        <h2 class="disp">Ready when you are.</h2>
        <p class="dim">We'll reply within one business day. Prefer a quick message? Reach us on WhatsApp.</p>
        <div class="opt-cta-actions">
          <Button href={`/contact/?service=${o.slug}`} variant="brand" size="lg" arrow>{o.cta}</Button>
          <WhatsAppButton label="WhatsApp us" />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .disp { font-family: var(--font-display); font-optical-sizing: auto; font-weight: 500; letter-spacing: -0.015em; }
  .kicker { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--brand-strong); margin-bottom: 1.2rem; }

  .opt-hero { padding-block: clamp(70px, 11vw, 140px) clamp(20px, 4vw, 36px); }
  .opt-back { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; font-weight: 600; color: var(--text-muted); margin-bottom: 2rem; transition: color 0.2s ease; }
  .opt-back :global(svg) { width: 16px; height: 16px; transform: rotate(180deg); }
  .opt-back:hover { color: var(--brand-strong); }
  .opt-h { font-size: clamp(2.4rem, 7vw, 4.6rem); line-height: 1.0; margin: 0; }
  .opt-lead { font-size: clamp(1.1rem, 2vw, 1.4rem); line-height: 1.55; color: var(--text-muted); max-width: 46ch; margin-top: 1.6rem; }
  .opt-price { display: flex; align-items: baseline; gap: 0.7rem; margin-top: 2rem; }
  .opt-price-value { font-size: clamp(2rem, 5vw, 3rem); font-weight: 600; color: var(--text); }
  .opt-price-note { font-size: 0.95rem; color: var(--text-muted); }

  .opt-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.8rem, 4vw, 3.2rem); align-items: start; }
  .opt-label { display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--brand-strong); margin-bottom: 1rem; }
  .opt-block > p { font-size: 1.08rem; line-height: 1.65; color: var(--text-muted); }
  .opt-includes { display: grid; gap: 0.7rem; }
  .opt-includes li { display: flex; align-items: flex-start; gap: 0.6rem; font-size: 1rem; color: var(--text); font-weight: 500; }
  .opt-includes :global(svg) { width: 18px; height: 18px; color: var(--accent); flex-shrink: 0; margin-top: 3px; }
  .opt-includes-wrap { margin-top: clamp(2rem, 4vw, 3rem); padding-top: clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--line); }
  .opt-note { margin-top: 1.4rem; font-size: 0.92rem; line-height: 1.55; color: var(--text-faint); max-width: 60ch; padding-left: 0.9rem; border-left: 2px solid var(--line-strong); }

  .opt-cta { margin-top: clamp(3rem, 6vw, 4.5rem); background: var(--ink); color: var(--on-dark); border-radius: var(--r-lg); padding: clamp(2rem, 5vw, 3.4rem); text-align: center; }
  .opt-cta h2 { font-size: clamp(1.6rem, 3.4vw, 2.4rem); color: #fff; }
  .opt-cta .dim { margin: 0.9rem auto 1.8rem; max-width: 460px; color: var(--on-dark-muted); }
  .opt-cta-actions { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; align-items: center; }

  @media (max-width: 680px) {
    .opt-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
