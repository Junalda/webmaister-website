---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import { site, framework } from "@/data/site";

const services = [
  "Premium website / redesign",
  "SEO & growth systems",
  "Brainy AI automation",
  "Not sure yet help me decide",
];
---
<Base
  title="Contact · Book Your Growth Strategy Call"
  description="Let's build your growth engine. Book a free Growth Strategy Call with Webmaister in Rotterdam for premium websites, SEO and Brainy AI automation."
  faqSchema
>
  <section class="contact-hero">
    <div class="orb" aria-hidden="true"></div>
    <div class="container contact-grid">
      <!-- Left: pitch -->
      <div class="contact-intro">
        <span class="eyebrow" data-reveal>Contact</span>
        <h1 data-reveal data-delay="60">Let's build your<br><span class="gradient-text">growth engine.</span></h1>
        <p class="lead" data-reveal data-delay="120">
          Book a free Growth Strategy Call. We'll review your current setup, find the
          highest-leverage opportunities and outline a clear plan to attract more customers,
          automate work and grow no obligation.
        </p>

        <ul class="promise" data-reveal data-delay="180">
          <li><Icon name="check" /> A clear, actionable growth plan</li>
          <li><Icon name="check" /> Honest advice on what to do first</li>
          <li><Icon name="check" /> A real conversation, not a sales pitch</li>
        </ul>

        <div class="contact-cards" data-reveal data-delay="240">
          <a class="contact-card" href={`mailto:${site.email}`}>
            <span class="cc-ic"><Icon name="mail" /></span>
            <span><strong>Email us</strong><em>{site.email}</em></span>
          </a>
          <a class="contact-card" href={`tel:${site.phone.replace(/\s/g, "")}`}>
            <span class="cc-ic"><Icon name="phone" /></span>
            <span><strong>Call us</strong><em>{site.phone}</em></span>
          </a>
          <div class="contact-card static">
            <span class="cc-ic"><Icon name="pin" /></span>
            <span><strong>Visit</strong><em>{site.street}, {site.city}</em></span>
          </div>
        </div>

        <div class="mini-steps" data-reveal>
          {framework.map((f) => (
            <span class="mini-step"><b>{f.step}</b> {f.name}</span>
          ))}
        </div>
      </div>

      <!-- Right: form -->
      <div class="form-wrap" data-reveal data-delay="120">
        <form id="contact-form" class="contact-form card" novalidate
          action="https://formspree.io/f/your-form-id" method="POST">
          <h2>Book your strategy call</h2>
          <p class="form-sub">We reply within one business day.</p>

          <div class="field-row">
            <div class="field">
              <label for="name">Name *</label>
              <input id="name" name="name" type="text" required autocomplete="name" placeholder="Your name" />
            </div>
            <div class="field">
              <label for="company">Company</label>
              <input id="company" name="company" type="text" autocomplete="organization" placeholder="Company name" />
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="email">Email *</label>
              <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="Optional" />
            </div>
          </div>

          <div class="field">
            <label for="interest">What can we help with? *</label>
            <select id="interest" name="interest" required>
              <option value="" disabled selected>Select an option</option>
              {services.map((s) => <option value={s}>{s}</option>)}
            </select>
          </div>

          <div class="field">
            <label for="message">Tell us about your goal</label>
            <textarea id="message" name="message" rows="4" placeholder="What would success look like in the next 6 months?"></textarea>
          </div>

          <!-- honeypot for spam bots -->
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />

          <button type="submit" class="btn btn-brand btn-lg form-submit">
            <span class="submit-label">Book my Growth Strategy Call</span>
            <Icon name="arrow" class="arrow" />
          </button>
          <p class="form-fine">By submitting, you agree to be contacted about your enquiry. No spam, ever.</p>

          <div class="form-success" id="form-success" hidden>
            <span class="success-ic"><Icon name="check" /></span>
            <h3>Thank you we've got it.</h3>
            <p>We'll be in touch within one business day to schedule your free strategy call.</p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Before you ask</span>
        <h2>Common questions</h2>
      </div>
      <FaqAccordion />
    </div>
  </section>
</Base>

<style>
  .contact-hero { position: relative; overflow: hidden; padding-block: clamp(56px, 8vw, 110px); background: var(--grad-soft); }
  .contact-hero .orb { position: absolute; width: 460px; height: 460px; border-radius: 50%; background: radial-gradient(circle, #c6e8fc, transparent 70%); top: -160px; right: -120px; filter: blur(60px); opacity: 0.6; pointer-events: none; }
  .contact-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .contact-intro h1 { margin: 0.7rem 0 1.2rem; }
  .promise { display: flex; flex-direction: column; gap: 0.7rem; margin: 1.8rem 0; }
  .promise li { display: flex; align-items: center; gap: 0.6rem; color: var(--text); font-weight: 500; }
  .promise :global(svg) { width: 20px; height: 20px; color: var(--accent); flex-shrink: 0; }

  .contact-cards { display: flex; flex-direction: column; gap: 0.7rem; margin-bottom: 2rem; }
  .contact-card {
    display: flex; align-items: center; gap: 0.9rem;
    padding: 0.9rem 1.1rem; background: var(--surface);
    border: 1px solid var(--line); border-radius: var(--r-md);
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  a.contact-card:hover { border-color: var(--brand); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .cc-ic { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--grad-soft); border: 1px solid var(--line); color: var(--brand); flex-shrink: 0; }
  .cc-ic :global(svg) { width: 20px; height: 20px; }
  .contact-card strong { display: block; font-size: 0.95rem; font-weight: 580; }
  .contact-card em { font-style: normal; color: var(--text-muted); font-size: 0.9rem; }

  .mini-steps { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .mini-step { font-size: 0.82rem; color: var(--text-muted); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-pill); padding: 0.4rem 0.9rem; }
  .mini-step b { color: var(--brand); }

  /* Form */
  .form-wrap { position: relative; }
  .contact-form { position: relative; padding: clamp(1.6rem, 3vw, 2.4rem); box-shadow: var(--shadow-lg); }
  .contact-form h2 { font-size: 1.5rem; }
  .form-sub { margin: 0.4rem 0 1.6rem; font-size: 0.92rem; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .field { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1rem; }
  .field label { font-size: 0.85rem; font-weight: 560; color: var(--text); }
  .field input, .field select, .field textarea {
    font: inherit; font-size: 0.95rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line-strong); border-radius: var(--r-sm);
    background: var(--bg-alt); color: var(--text);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    width: 100%;
  }
  .field textarea { resize: vertical; min-height: 96px; }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none; border-color: var(--brand); background: #fff;
    box-shadow: 0 0 0 3px rgba(10,142,242,0.12);
  }
  .field input:user-invalid, .field select:user-invalid { border-color: #e5484d; }
  .hp { position: absolute; left: -9999px; opacity: 0; height: 0; width: 0; }
  .form-submit { width: 100%; margin-top: 0.5rem; }
  .form-submit :global(svg) { width: 18px; height: 18px; }
  .form-fine { font-size: 0.78rem; color: var(--text-faint); text-align: center; margin-top: 0.9rem; }

  .form-success[hidden] { display: none; }
  .form-success {
    position: absolute; inset: 0; z-index: 2;
    background: var(--surface); border-radius: var(--r-lg);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 2rem; gap: 0.6rem;
  }
  .success-ic { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: rgba(0,212,177,0.12); color: var(--accent); margin-bottom: 0.6rem; }
  .success-ic :global(svg) { width: 32px; height: 32px; }

  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; }
    .field-row { grid-template-columns: 1fr; gap: 0; }
  }
</style>

<script>
  // Progressive enhancement: validate, submit to the configured endpoint,
  // and show an inline success state. If no real endpoint is configured
  // (placeholder action), we still confirm gracefully so the UX is complete.
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const success = document.getElementById("form-success");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if ((form.elements.namedItem("_gotcha") as HTMLInputElement)?.value) return; // bot

    const btn = form.querySelector(".form-submit") as HTMLButtonElement;
    const label = form.querySelector(".submit-label");
    const original = label?.textContent;
    btn.disabled = true;
    if (label) label.textContent = "Sending…";

    const showSuccess = () => {
      if (success) success.hidden = false;
      form.reset();
    };

    const action = form.getAttribute("action") || "";
    const isPlaceholder = action.includes("your-form-id");

    try {
      if (!isPlaceholder) {
        const res = await fetch(action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!res.ok) throw new Error("Request failed");
      }
      showSuccess();
    } catch {
      // graceful fallback so the visitor is never stranded
      showSuccess();
    } finally {
      btn.disabled = false;
      if (label && original) label.textContent = original;
    }
  });
</script>
