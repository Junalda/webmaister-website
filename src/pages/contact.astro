---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import { site, framework } from "@/data/site";

// WhatsApp brand glyph (filled). Inlined here so it renders as an accurate
// icon without touching the stroke-based Icon set.
const whatsappIcon = `<path d="M17.5 14.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z"/><path d="M12.04 2.5A9.48 9.48 0 0 0 3.9 16.86L2.5 21.5l4.75-1.25a9.48 9.48 0 1 0 4.79-17.75Zm0 17.3a7.83 7.83 0 0 1-3.98-1.09l-.29-.17-2.82.74.75-2.75-.18-.29a7.82 7.82 0 1 1 6.52 3.56Z"/>`;
---
<Base
  title="Contact · Book Your Growth Strategy Call"
  description="Let's build your growth engine. Get in touch with Webmaister in Rotterdam by WhatsApp, email or phone for premium websites, SEO and Brainy AI automation."
  faqSchema
>
  <section class="contact-hero">
    <div class="orb" aria-hidden="true"></div>
    <div class="container contact-grid">
      <!-- Left: pitch -->
      <div class="contact-intro">
        <span class="eyebrow" data-reveal>Contact</span>
        <h1 data-reveal data-delay="60">Let's build your<br><span class="gradient-text">growth engine.</span></h1>
        <p class="lead" data-reveal data-delay="120">
          Book a free Growth Strategy Call. We'll review your current setup, find the
          highest-leverage opportunities and outline a clear plan to attract more customers,
          automate work and grow no obligation.
        </p>

        <ul class="promise" data-reveal data-delay="180">
          <li><Icon name="check" /> A clear, actionable growth plan</li>
          <li><Icon name="check" /> Honest advice on what to do first</li>
          <li><Icon name="check" /> A real conversation, not a sales pitch</li>
        </ul>

        <div class="mini-steps" data-reveal>
          {framework.map((f) => (
            <span class="mini-step"><b>{f.step}</b> {f.name}</span>
          ))}
        </div>
      </div>

      <!-- Right: direct contact -->
      <div class="reach-wrap" data-reveal data-delay="120">
        <div class="reach card">
          <h2>Get in touch</h2>
          <p class="reach-sub">Message us directly no forms, no waiting. We reply within one business day.</p>

          <a class="reach-wa" href={`https://wa.me/${site.whatsappHref}`} target="_blank" rel="noopener noreferrer">
            <span class="wa-ic">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={whatsappIcon} />
            </span>
            <span class="wa-text"><strong>Chat on WhatsApp</strong><em>{site.whatsapp}</em></span>
            <Icon name="arrow" class="wa-arrow" />
          </a>

          <div class="reach-divider"><span>or reach us another way</span></div>

          <div class="contact-cards">
            <a class="contact-card" href={`mailto:${site.email}`}>
              <span class="cc-ic"><Icon name="mail" /></span>
              <span><strong>Email us</strong><em>{site.email}</em></span>
            </a>
            <a class="contact-card" href={`tel:${site.phoneHref}`}>
              <span class="cc-ic"><Icon name="phone" /></span>
              <span><strong>Call us</strong><em>{site.phone}</em></span>
            </a>
            <div class="contact-card static">
              <span class="cc-ic"><Icon name="shield" /></span>
              <span><strong>KvK</strong><em>{site.kvk}</em></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Before you ask</span>
        <h2>Common questions</h2>
      </div>
      <FaqAccordion />
    </div>
  </section>
</Base>

<style>
  .contact-hero { position: relative; overflow: hidden; padding-block: clamp(56px, 8vw, 110px); background: var(--grad-soft); }
  .contact-hero .orb { position: absolute; width: 460px; height: 460px; border-radius: 50%; background: radial-gradient(circle, #c6e8fc, transparent 70%); top: -160px; right: -120px; filter: blur(60px); opacity: 0.6; pointer-events: none; }
  .contact-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .contact-intro h1 { margin: 0.7rem 0 1.2rem; }
  .promise { display: flex; flex-direction: column; gap: 0.7rem; margin: 1.8rem 0; }
  .promise li { display: flex; align-items: center; gap: 0.6rem; color: var(--text); font-weight: 500; }
  .promise :global(svg) { width: 20px; height: 20px; color: var(--accent); flex-shrink: 0; }

  .mini-steps { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .mini-step { font-size: 0.82rem; color: var(--text-muted); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-pill); padding: 0.4rem 0.9rem; }
  .mini-step b { color: var(--brand); }

  /* Direct-contact panel */
  .reach { padding: clamp(1.6rem, 3vw, 2.4rem); box-shadow: var(--shadow-lg); }
  .reach h2 { font-size: 1.5rem; }
  .reach-sub { margin: 0.4rem 0 1.6rem; font-size: 0.92rem; color: var(--text-muted); }

  /* WhatsApp primary action */
  .reach-wa {
    display: flex; align-items: center; gap: 0.9rem;
    padding: 1rem 1.15rem; border-radius: var(--r-md);
    background: #25d366; color: #06351a;
    box-shadow: 0 14px 34px -14px rgba(37,211,102,0.6);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .reach-wa:hover { transform: translateY(-2px); box-shadow: 0 20px 44px -14px rgba(37,211,102,0.7); }
  .wa-ic { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: rgba(255,255,255,0.35); color: #075e2e; flex-shrink: 0; }
  .wa-ic svg { width: 24px; height: 24px; }
  .wa-text { display: flex; flex-direction: column; }
  .wa-text strong { font-size: 1rem; font-weight: 650; color: #06351a; }
  .wa-text em { font-style: normal; font-size: 0.9rem; color: #0a4d27; }
  .wa-arrow { margin-left: auto; width: 20px; height: 20px; color: #06351a; transition: transform 0.2s ease; }
  .reach-wa:hover .wa-arrow { transform: translateX(3px); }

  .reach-divider { display: flex; align-items: center; gap: 0.8rem; margin: 1.4rem 0; color: var(--text-faint); font-size: 0.8rem; }
  .reach-divider::before, .reach-divider::after { content: ""; height: 1px; background: var(--line); flex: 1; }

  .contact-cards { display: flex; flex-direction: column; gap: 0.7rem; }
  .contact-card {
    display: flex; align-items: center; gap: 0.9rem;
    padding: 0.9rem 1.1rem; background: var(--surface);
    border: 1px solid var(--line); border-radius: var(--r-md);
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  a.contact-card:hover { border-color: var(--brand); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .cc-ic { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--grad-soft); border: 1px solid var(--line); color: var(--brand); flex-shrink: 0; }
  .cc-ic :global(svg) { width: 20px; height: 20px; }
  .contact-card strong { display: block; font-size: 0.95rem; font-weight: 580; }
  .contact-card em { font-style: normal; color: var(--text-muted); font-size: 0.9rem; }

  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>

