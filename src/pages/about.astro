---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import FinalCta from "@/components/FinalCta.astro";
import { site, pillars, framework } from "@/data/site";

const facts = [
  { label: "Founded", value: site.founded },
  { label: "Based in", value: `${site.city}, Netherlands` },
  { label: "KvK", value: site.kvk },
  { label: "Serves", value: site.areaServed.join(" · ") },
];

const aboutLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": `${site.url}/about/#aboutpage`,
  url: `${site.url}/about/`,
  name: `About ${site.name}`,
  description: site.description,
  mainEntity: { "@id": `${site.url}/#organization` },
};
---
<Base
  title="About · Growth & AI Infrastructure Partner in Rotterdam"
  description={site.description}
>
  <section class="page-hero">
    <div class="container center" style="max-width:820px">
      <span class="eyebrow" data-reveal>About Webmaister</span>
      <h1 data-reveal data-delay="60">More than a web agency.<br><span class="gradient-text">A growth partner.</span></h1>
      <p class="lead" data-reveal data-delay="120" style="margin:1.4rem auto 0;max-width:640px">{site.description}</p>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow about-intro" data-reveal>
      <p>We don't see a website as a finished product. We see it as the foundation a business grows on, connected to growth systems and to <strong>Brainy</strong>, our AI layer that handles repetitive work around the clock.</p>
      <p>Founded in {site.founded} and based in {site.city}, the Netherlands, Webmaister works with ambitious small and mid-sized businesses that want to grow without adding overhead, across {site.city}, Zuid-Holland and the wider Netherlands as well as remotely.</p>
      <p>Our promise is simple: more customers, less manual work, and a digital foundation built to scale. We don't start with design, we start with understanding where a business wants to go, then build the platform, systems and automation to take it there.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">At a glance</span>
        <h2>The facts</h2>
      </div>
      <ul class="facts grid grid-4" data-reveal>
        {facts.map((f) => (
          <li class="fact card">
            <span class="fact-label">{f.label}</span>
            <span class="fact-value">{f.value}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">What we do</span>
        <h2>Three connected pillars</h2>
      </div>
      <div class="grid grid-3" data-reveal>
        {pillars.map((p) => (
          <article class="card card-hover">
            <h3>{p.name}</h3>
            <p>{p.short}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">How we work</span>
        <h2>A simple, proven framework</h2>
      </div>
      <ol class="grid grid-4 about-process" data-reveal>
        {framework.map((f) => (
          <li class="card">
            <span class="fw-num">{f.step}</span>
            <h3>{f.name}</h3>
            <p>{f.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <FinalCta
    title="Let's build your<br>growth engine."
    text="Book a free Growth Strategy Call and we'll map a clear path to the digital foundation your business needs to grow."
  />

  <script type="application/ld+json" set:html={JSON.stringify(aboutLd)} is:inline />
</Base>

<style>
  .page-hero { padding-block: clamp(60px, 9vw, 120px) clamp(40px, 6vw, 70px); background: var(--grad-soft); border-bottom: 1px solid var(--line); }
  .about-intro p { font-size: clamp(1.1rem, 2vw, 1.3rem); line-height: 1.65; color: var(--text); }
  .about-intro p + p { margin-top: 1.3rem; }
  .facts { margin-top: 3rem; }
  .fact { display: flex; flex-direction: column; gap: 0.35rem; text-align: center; }
  .fact-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--brand-strong); }
  .fact-value { font-size: 1.15rem; font-weight: 650; color: var(--ink); }
  .about-process .fw-num {
    display: inline-grid; place-items: center; font-size: 0.9rem; font-weight: 700;
    color: var(--brand); background: var(--bg-tint); width: 46px; height: 46px;
    border-radius: 13px; margin-bottom: 1rem; border: 1px solid rgba(10,142,242,0.16);
  }
  .about-process h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }
  .grid-3 .card h3 { margin-bottom: 0.5rem; }
</style>
