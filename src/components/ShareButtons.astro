---
// Social share buttons for blog posts.
// WhatsApp, Facebook, LinkedIn and X use official web-share URLs (work
// everywhere). Instagram has no web-share URL, so that button uses the native
// share sheet (which lists Instagram on mobile) and falls back to copying the
// link. A copy-link button is included too.
interface Props {
  url: string;
  title: string;
  label?: string;
}
const { url, title, label = "Deel dit artikel" } = Astro.props;
const enc = encodeURIComponent;
const waHref = `https://wa.me/?text=${enc(`${title} ${url}`)}`;
const fbHref = `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`;
const liHref = `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`;
const xHref = `https://twitter.com/intent/tweet?url=${enc(url)}&text=${enc(title)}`;
---
<div class="share" data-reveal>
  <span class="share-label">{label}</span>
  <div class="share-row">
    <a class="share-btn wa" href={waHref} target="_blank" rel="noopener noreferrer" aria-label="Deel op WhatsApp">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
    </a>
    <a class="share-btn fb" href={fbHref} target="_blank" rel="noopener noreferrer" aria-label="Deel op Facebook">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
    </a>
    <a class="share-btn li" href={liHref} target="_blank" rel="noopener noreferrer" aria-label="Deel op LinkedIn">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
    </a>
    <a class="share-btn x" href={xHref} target="_blank" rel="noopener noreferrer" aria-label="Deel op X">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
    </a>
    <button class="share-btn ig" type="button" data-share-native data-url={url} data-title={title} aria-label="Deel op Instagram">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="2"/>
        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
        <circle cx="17.2" cy="6.8" r="1.5" fill="currentColor"/>
      </svg>
    </button>
    <button class="share-btn copy" type="button" data-share-copy data-url={url} aria-label="Kopieer link">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9.5 14.5l5-5M10.8 7.7l1.2-1.2a3.6 3.6 0 0 1 5.1 5.1l-2.1 2.1M13.2 16.3l-1.2 1.2a3.6 3.6 0 0 1-5.1-5.1l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <span class="share-toast" data-share-toast hidden></span>
  </div>
</div>

<style>
  .share { display: flex; flex-direction: column; gap: 0.7rem; }
  .share-label { font-size: 0.85rem; font-weight: 600; color: var(--text-muted); }
  .share-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; position: relative; }
  .share-btn {
    width: 42px; height: 42px; border-radius: 50%;
    display: grid; place-items: center;
    color: #fff; border: none; cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.25s ease, filter 0.2s ease, background 0.2s ease;
  }
  .share-btn svg { width: 21px; height: 21px; }
  .share-btn:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .share-btn:active { transform: translateY(0); }
  .wa { background: #25d366; }
  .fb { background: #1877f2; }
  .li { background: #0a66c2; }
  .x { background: #000; }
  .ig { background: linear-gradient(45deg, #feda75 0%, #fa7e1e 25%, #d62976 55%, #962fbf 80%, #4f5bd5 100%); }
  .copy { background: var(--bg-alt); color: var(--ink); border: 1px solid var(--line-strong); }
  .copy:hover { background: var(--surface); }
  .share-toast {
    font-size: 0.82rem; font-weight: 560; color: var(--text);
    background: var(--surface); border: 1px solid var(--line-strong);
    border-radius: var(--r-pill); padding: 0.4rem 0.85rem; box-shadow: var(--shadow-sm);
    animation: toast-in 0.2s ease;
  }
  @keyframes toast-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
</style>

<script>
  const showToast = (btn: HTMLElement, msg: string) => {
    const toast = btn.closest(".share-row")?.querySelector<HTMLElement>("[data-share-toast]");
    if (!toast) return;
    toast.textContent = msg;
    toast.hidden = false;
    window.clearTimeout((toast as any)._t);
    (toast as any)._t = window.setTimeout(() => (toast.hidden = true), 2500);
  };

  const copy = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  };

  // Instagram: no web-share URL exists. Use the native share sheet (lists
  // Instagram on mobile); otherwise copy the link to paste into Instagram.
  document.querySelectorAll<HTMLElement>("[data-share-native]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const url = btn.dataset.url ?? "";
      const title = btn.dataset.title ?? "";
      if (navigator.share) {
        try {
          await navigator.share({ title, url });
          return;
        } catch {
          /* cancelled/unsupported — fall through to copy */
        }
      }
      const ok = await copy(url);
      showToast(btn, ok ? "Link gekopieerd — plak 'm in Instagram" : "Kopiëren niet gelukt");
    });
  });

  document.querySelectorAll<HTMLElement>("[data-share-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const ok = await copy(btn.dataset.url ?? "");
      showToast(btn, ok ? "Link gekopieerd" : "Kopiëren niet gelukt");
    });
  });
</script>
