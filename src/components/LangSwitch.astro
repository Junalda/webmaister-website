---
import { switchUrl, type Lang } from "@/i18n";
interface Props {
  lang?: Lang;
  class?: string;
}
const { lang = "en", class: className } = Astro.props;
const path = Astro.url.pathname;
const nlHref = lang === "nl" ? path : switchUrl(path, "en");
const enHref = lang === "en" ? path : switchUrl(path, "nl");
---
<div class:list={["lang-switch", className]} role="group" aria-label="Taal / Language">
  <a href={nlHref} class:list={["lang-opt", { active: lang === "nl" }]} aria-current={lang === "nl" ? "true" : undefined} hreflang="nl">NL</a>
  <span class="lang-sep" aria-hidden="true">/</span>
  <a href={enHref} class:list={["lang-opt", { active: lang === "en" }]} aria-current={lang === "en" ? "true" : undefined} hreflang="en">EN</a>
</div>

<style>
  .lang-switch { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.85rem; font-weight: 600; }
  .lang-opt { color: var(--text-muted); padding: 0.1rem 0.2rem; border-radius: 4px; transition: color .18s ease; }
  .lang-opt:hover { color: var(--text); }
  .lang-opt.active { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
  .lang-sep { color: var(--line-strong); }
</style>
