---
// One sitewide JSON-LD @graph: organization, founder, website, packages,
// plus AboutPage, FAQPage and BreadcrumbList where the page shows them.
import { site, businessAddress, schemaIds, core, packages, faqs, faqsNL, startPageFaqs } from "@/data/site";

interface Props {
  faq?: boolean;
  services?: boolean;
  title?: string;
}
const { title } = Astro.props;

const path = Astro.url.pathname;
const bare = path.replace(/\/$/, "") || "/";
const isEnglish = bare === "/en" || bare.startsWith("/en/") || bare === "/start" || bare.startsWith("/start/") || bare.startsWith("/blog");
const description = isEnglish ? core.en : core.nl;
const canonical = new URL(path.endsWith("/") ? path : `${path}/`, site.url).href;

// sameAs only lists profiles already in the repo. Never emit
// linkedin.com/company/webmaister (a different Hungarian agency).
// linkedin.com/company/webmaister-io would be allowed if it were in config.
const safeSameAs = [site.social.linkedin, site.social.instagram].filter((url) => {
  if (!url) return false;
  return !/linkedin\.com\/company\/webmaister\/?(?:$|\?)/.test(url);
});

const areaServed = site.areaServed.map((name) => ({ "@type": "Place", name }));

const hasGeo = Boolean(site.geo.lat && site.geo.lng);

const organization = {
  "@type": ["ProfessionalService", "Organization"],
  "@id": schemaIds.organization,
  name: site.name,
  legalName: site.legalName,
  alternateName: site.alternateName,
  url: site.url,
  logo: `${site.url}/logo.svg`,
  image: `${site.url}/og.png`,
  description,
  foundingDate: site.foundingDate,
  email: site.email,
  telephone: site.phone,
  currenciesAccepted: "EUR",
  identifier: {
    "@type": "PropertyValue",
    propertyID: "KvK",
    value: site.kvk,
  },
  founder: { "@id": schemaIds.founder },
  address: {
    "@type": "PostalAddress",
    streetAddress: businessAddress.streetAddress,
    postalCode: businessAddress.postalCode,
    addressLocality: businessAddress.addressLocality,
    addressRegion: businessAddress.addressRegion,
    addressCountry: businessAddress.addressCountry,
  },
  ...(hasGeo
    ? { geo: { "@type": "GeoCoordinates", latitude: site.geo.lat, longitude: site.geo.lng } }
    : {}),
  areaServed,
  sameAs: safeSameAs,
};

const founder = {
  "@type": "Person",
  "@id": schemaIds.founder,
  name: "Junalda Meiland",
  jobTitle: "Founder",
  worksFor: { "@id": schemaIds.organization },
  knowsAbout: [
    "web development",
    "software development",
    "IT project management",
    "SEO",
    "AI search / generative engine optimization",
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Rotterdam",
    addressCountry: "NL",
  },
  sameAs: [site.social.founderLinkedin],
};

const website = {
  "@type": "WebSite",
  "@id": schemaIds.website,
  url: site.url,
  name: site.name,
  description,
  publisher: { "@id": schemaIds.organization },
  inLanguage: ["nl", "en"],
};

const packageServices = packages.map((pkg) => {
  const node: Record<string, unknown> = {
    "@type": "Service",
    "@id": `https://webmaister.io/#service-${pkg.id}`,
    name: pkg.name,
    description: isEnglish ? pkg.description : pkg.descriptionNL,
    provider: { "@id": schemaIds.organization },
    areaServed,
    url: `${site.url}/start/`,
  };
  if ("setup" in pkg && "monthly" in pkg) {
    node.offers = [
      {
        "@type": "Offer",
        name: `${pkg.name} setup`,
        price: String(pkg.setup),
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
        url: `${site.url}/start/`,
      },
      {
        "@type": "Offer",
        name: `${pkg.name} monthly`,
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
        url: `${site.url}/start/`,
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: String(pkg.monthly),
          priceCurrency: "EUR",
          unitCode: "P1M",
          referenceQuantity: {
            "@type": "QuantitativeValue",
            value: 1,
            unitCode: "MON",
          },
        },
      },
    ];
  }
  return node;
});

const isAbout = bare === "/over-ons" || bare === "/en/about";
const aboutPage = isAbout
  ? {
      "@type": "AboutPage",
      "@id": `${canonical}#aboutpage`,
      url: canonical,
      name: bare === "/en/about" ? "About Webmaister" : "Over Webmaister",
      description,
      inLanguage: bare === "/en/about" ? "en" : "nl",
      mainEntity: { "@id": schemaIds.organization },
      isPartOf: { "@id": schemaIds.website },
    }
  : null;

let faqItems: { q: string; a: string }[] | null = null;
if (bare === "/" || bare === "/diensten") faqItems = faqsNL;
else if (bare === "/en" || bare === "/en/solutions" || bare === "/en/contact") faqItems = faqs;
else if (bare === "/start") faqItems = startPageFaqs;

const faqPage = faqItems
  ? {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: faqItems.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;

const deslug = (s: string) => s.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
const locales = new Set(["nl", "en"]);
const parts = path.split("/").filter(Boolean);
const isEnPath = parts[0] === "en";
const crumbItems: { "@type": string; position: number; name: string; item: string }[] = [
  { "@type": "ListItem", position: 1, name: "Home", item: isEnPath ? `${site.url}/en/` : `${site.url}/` },
];
parts.forEach((seg, i) => {
  if (locales.has(seg)) return;
  const isLast = i === parts.length - 1;
  crumbItems.push({
    "@type": "ListItem",
    position: crumbItems.length + 1,
    name: isLast && title ? title.split(" · ")[0].split(" | ")[0] : deslug(seg),
    item: `${site.url}/${parts.slice(0, i + 1).join("/")}/`,
  });
});
const breadcrumb = crumbItems.length > 1
  ? { "@type": "BreadcrumbList", itemListElement: crumbItems }
  : null;

const graph = [website, organization, founder, ...packageServices, aboutPage, faqPage, breadcrumb].filter(Boolean);
const data = { "@context": "https://schema.org", "@graph": graph };
---
<script type="application/ld+json" set:html={JSON.stringify(data)} is:inline />
