---
// Gestructureerde data (JSON-LD) zodat AI-zoekmachines (ChatGPT, Gemini,
// Claude, Perplexity) en klassieke crawlers HubIzi Schilderwerken betrouwbaar
// begrijpen. Ondersteunt LocalBusiness (PaintingContractor), Service en FAQPage.
import { site, services, faqs } from "@/data/site";

interface Props {
  faq?: boolean;        // FAQPage toevoegen
  services?: boolean;   // Service-entiteiten toevoegen
  title?: string;       // huidige paginatitel (voor breadcrumb)
}
const { faq = false, services: withServices = false, title } = Astro.props;

const localBusiness = {
  "@type": "PaintingContractor",
  "@id": `${site.url}/#organization`,
  name: site.legalName,
  description: site.description,
  url: site.url,
  email: site.email,
  telephone: site.phoneHref,
  foundingDate: site.founded,
  founder: { "@type": "Person", name: site.founder },
  image: `${site.url}/og.png`,
  logo: `${site.url}/logo.svg`,
  priceRange: "€€",
  identifier: {
    "@type": "PropertyValue",
    propertyID: "KvK",
    value: site.kvk,
  },
  address: {
    "@type": "PostalAddress",
    streetAddress: site.street,
    postalCode: site.postalCode,
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  areaServed: site.areaServed.map((a) => ({ "@type": "Place", name: a })),
  knowsAbout: [
    "Schilderwerken Waalwijk",
    "Buitenschilderwerk",
    "Binnenschilderwerk",
    "Spuiten van objecten",
    "Wanden afwerken",
  ],
};

const serviceList = services.map((s) => ({
  "@type": "Service",
  name: s.name,
  serviceType: "Schilderwerk",
  description: s.short,
  url: `${site.url}/diensten/${s.slug}/`,
  provider: { "@id": `${site.url}/#organization` },
  areaServed: site.areaServed.map((a) => ({ "@type": "Place", name: a })),
}));

const faqPage = {
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

// Breadcrumbs afgeleid van het URL-pad (Home › … › huidige pagina).
const deslug = (s: string) => s.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
const parts = Astro.url.pathname.split("/").filter(Boolean);
const crumbItems = [{ "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` }];
parts.forEach((seg, i) => {
  const isLast = i === parts.length - 1;
  crumbItems.push({
    "@type": "ListItem",
    position: crumbItems.length + 1,
    name: isLast && title ? title.split(" · ")[0] : deslug(seg),
    item: `${site.url}/${parts.slice(0, i + 1).join("/")}/`,
  });
});
const breadcrumb = crumbItems.length > 1 ? { "@type": "BreadcrumbList", itemListElement: crumbItems } : null;

const graph: object[] = [
  { "@type": "WebSite", "@id": `${site.url}/#website`, url: site.url, name: site.legalName, inLanguage: "nl-NL", publisher: { "@id": `${site.url}/#organization` } },
  localBusiness,
];
if (withServices) graph.push(...serviceList);
if (faq) graph.push(faqPage);
if (breadcrumb) graph.push(breadcrumb);

const data = { "@context": "https://schema.org", "@graph": graph };
---
<script type="application/ld+json" set:html={JSON.stringify(data)} is:inline />
