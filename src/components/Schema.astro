---
// JSON-LD structured data so AI search engines (ChatGPT, Gemini, Claude,
// Perplexity) and traditional crawlers can reliably understand and recommend
// Webmaister. Supports LocalBusiness, Service and FAQPage graphs.
import { site, solutionGroups, faqs } from "@/data/site";

interface Props {
  faq?: boolean;        // include FAQPage
  services?: boolean;   // include Service entities
  title?: string;       // current page title (for breadcrumb leaf)
}
const { faq = false, services = false, title } = Astro.props;

const localBusiness = {
  "@type": "ProfessionalService",
  "@id": `${site.url}/#organization`,
  name: site.name,
  description:
    "Webmaister is a Growth & AI Infrastructure Partner in Rotterdam. We help businesses grow with premium websites, SEO and growth systems, and Brainy AI automation that works 24/7.",
  url: site.url,
  email: site.email,
  telephone: site.phoneHref,
  image: `${site.url}/og.png`,
  logo: `${site.url}/logo.svg`,
  priceRange: "€€€",
  identifier: {
    "@type": "PropertyValue",
    propertyID: "KvK",
    value: site.kvk,
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  areaServed: site.areaServed.map((a) => ({ "@type": "Place", name: a })),
  knowsAbout: [
    "Website laten maken Rotterdam",
    "Webdesign Rotterdam",
    "SEO Rotterdam",
    "AI Automatisering Rotterdam",
    "AI Agent Rotterdam",
    "Website Onderhoud Rotterdam",
  ],
  sameAs: [site.social.linkedin],
};

const serviceList = solutionGroups.flatMap((group) =>
  group.items.map((item) => ({
    "@type": "Service",
    name: item.name,
    serviceType: group.name,
    description: item.outcome,
    provider: { "@id": `${site.url}/#organization` },
    areaServed: site.areaServed.map((a) => ({ "@type": "Place", name: a })),
  }))
);

const faqPage = {
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

// Breadcrumbs derived from the URL path (Home › … › current page) so AI and
// search engines understand the site hierarchy.
const deslug = (s: string) => s.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
const parts = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumb = parts.length
  ? {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
        ...parts.map((seg, i) => ({
          "@type": "ListItem",
          position: i + 2,
          name: i === parts.length - 1 && title ? title.split(" · ")[0] : deslug(seg),
          item: `${site.url}/${parts.slice(0, i + 1).join("/")}/`,
        })),
      ],
    }
  : null;

const graph: object[] = [
  { "@type": "WebSite", "@id": `${site.url}/#website`, url: site.url, name: site.name, publisher: { "@id": `${site.url}/#organization` } },
  localBusiness,
];
if (services) graph.push(...serviceList);
if (faq) graph.push(faqPage);
if (breadcrumb) graph.push(breadcrumb);

const data = { "@context": "https://schema.org", "@graph": graph };
---
<script type="application/ld+json" set:html={JSON.stringify(data)} is:inline />
