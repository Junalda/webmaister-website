---
import { site, nav, services, ctaPrimary } from "@/data/site";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo />
        <p>{site.description}</p>
        <a href={ctaPrimary.href} class="btn btn-brand">{ctaPrimary.label}</a>
      </div>

      <div class="footer-col">
        <h4>Menu</h4>
        <ul>
          {nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Diensten</h4>
        <ul>
          {services.map((s) => <li><a href={`/diensten/${s.slug}/`}>{s.name}</a></li>)}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Contact</h4>
        <ul class="contact-list">
          <li><Icon name="phone" /> <a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
          <li><Icon name="mail" /> <a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><Icon name="pin" /> <span>{site.street}<br />{site.postalCode} {site.city}</span></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {site.legalName}. Alle rechten voorbehouden.</span>
      <span class="footer-meta">KvK {site.kvk} · Vakwerk vanuit {site.city}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-alt);
    color: var(--text);
    padding-block: clamp(56px, 7vw, 88px) 32px;
    margin-top: auto;
    border-top: 3px solid transparent;
    border-image: var(--grad-brand) 1;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.2fr 1.4fr;
    gap: clamp(2rem, 4vw, 3rem);
  }
  .footer-brand p { color: var(--text-muted); margin: 1.1rem 0 1.6rem; max-width: 40ch; font-size: 0.95rem; }
  .footer-col h4 {
    color: var(--text);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1.1rem;
    font-weight: 600;
  }
  .footer-col ul { display: flex; flex-direction: column; gap: 0.7rem; }
  .footer-col a, .footer-col span { color: var(--text-muted); font-size: 0.95rem; transition: color 0.2s ease; }
  .footer-col a:hover { color: var(--brand-strong); }
  .contact-list li { display: flex; align-items: flex-start; gap: 0.55rem; }
  .contact-list :global(svg) { width: 17px; height: 17px; color: var(--brand); flex-shrink: 0; margin-top: 3px; }
  .footer-bottom {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.6rem;
    border-top: 1px solid var(--line-strong);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-faint);
  }
  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
