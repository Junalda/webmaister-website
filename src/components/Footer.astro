---
import { site, navNL, navEN, ctaNL, ctaEN } from "@/data/site";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import type { Lang } from "@/i18n";
interface Props { lang?: Lang; }
const { lang = "en" } = Astro.props;
const year = new Date().getFullYear();
const footerNav = lang === "nl" ? navNL : navEN;
const cta = lang === "nl" ? ctaNL : ctaEN;
const boilerplate = lang === "nl" ? site.descriptionNL : site.description;
// One unique URL per service (de-duplicated).
const seo = [
  { label: "Website laten maken Rotterdam", href: "/nl/website-laten-maken-rotterdam/" },
  { label: "Webdesign Rotterdam", href: "/nl/webdesign-rotterdam/" },
  { label: "SEO Rotterdam", href: "/nl/seo-rotterdam/" },
  { label: "AI-automatisering Rotterdam", href: "/nl/ai-automatisering-rotterdam/" },
  { label: "AI-agent Rotterdam", href: "/nl/ai-agent-rotterdam/" },
  { label: "Website-onderhoud Rotterdam", href: "/nl/website-onderhoud-rotterdam/" },
  { label: "GEO-optimalisatie", href: "/nl/geo-optimalisatie/" },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo mono />
        <p>{boilerplate}</p>
        <a href={cta.href} class="btn btn-brand">{cta.label}</a>
      </div>

      <div class="footer-col">
        <h4>{lang === "nl" ? "Navigatie" : "Navigate"}</h4>
        <ul>
          {footerNav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Contact</h4>
        <ul class="contact-list">
          <li><Icon name="pin" /> <span>{site.streetAddress}, {site.postalCode} {site.city}, {lang === "nl" ? "Nederland" : "The Netherlands"}</span></li>
          <li><Icon name="mail" /> <a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li class="wa-li"><WhatsAppIcon /> <a href={`https://wa.me/${site.whatsappHref}`} target="_blank" rel="noopener noreferrer">{site.whatsapp}</a></li>
          <li><Icon name="shield" /> <span>KvK {site.kvk}</span></li>
        </ul>
      </div>

      <div class="footer-col footer-seo">
        <h4><a href={lang === "nl" ? "/diensten/" : "/en/solutions/"}>Rotterdam expertise</a></h4>
        <ul>
          {seo.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {site.legalName}. {lang === "nl" ? "Alle rechten voorbehouden." : "All rights reserved."} · KvK {site.kvk}</span>
      <span class="footer-locale">{lang === "nl" ? "Gebouwd vanuit" : "Proudly building from"} {site.city}, {site.country}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--grad-ink);
    color: var(--on-dark);
    padding-block: clamp(56px, 7vw, 88px) 32px;
    margin-top: auto;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.2fr 1.4fr;
    gap: clamp(2rem, 4vw, 3rem);
  }
  .footer-brand p { color: var(--on-dark-muted); margin: 1.1rem 0 1.6rem; max-width: 38ch; font-size: 0.95rem; }
  .footer-col h4 {
    color: #fff;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1.1rem;
    font-weight: 600;
  }
  .footer-col h4 a { color: inherit; text-decoration: none; }
  .footer-col h4 a:hover { color: var(--accent); }
  .footer-col ul { display: flex; flex-direction: column; gap: 0.7rem; }
  .footer-col a, .footer-col span { color: var(--on-dark-muted); font-size: 0.95rem; transition: color 0.2s ease; }
  .footer-col a:hover { color: #fff; }
  .contact-list li { display: flex; align-items: center; gap: 0.55rem; }
  .contact-list :global(svg) { width: 17px; height: 17px; color: var(--brand-2); flex-shrink: 0; }
  .contact-list .wa-li :global(svg) { color: #25d366; }
  .footer-seo li a, .footer-seo li span { font-size: 0.88rem; }
  .footer-bottom {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.6rem;
    border-top: 1px solid var(--line-dark);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--on-dark-muted);
  }
  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
