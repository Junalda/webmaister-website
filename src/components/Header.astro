---
import { nav, ctaPrimary, site } from "@/data/site";
import Logo from "./Logo.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
const whatsappHref = `https://wa.me/${site.whatsappHref}`;
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
// The logo already links home, so drop the redundant "Home" item in the header.
const headerNav = nav.filter((item) => item.href !== "/");
---
<header class:list={["site-header", { "is-overlay": path === "/" }]} id="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Webmaister home">
      <Logo />
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      {headerNav.map((item) => (
        <a href={item.href} class:list={["nav-link", { active: isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a href={whatsappHref} class="wa-btn hidden-mobile" target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp">
        <WhatsAppIcon />
      </a>
      <a href={ctaPrimary.href} class="btn btn-brand hidden-mobile">{ctaPrimary.label}</a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Mobile">
      {headerNav.map((item) => (
        <a href={item.href} class:list={["mobile-link", { active: isActive(item.href) }]}>{item.label}</a>
      ))}
    </nav>
    <a href={ctaPrimary.href} class="btn btn-brand btn-lg">{ctaPrimary.label}</a>
    <a href={whatsappHref} class="wa-btn-full" target="_blank" rel="noopener noreferrer">
      <WhatsAppIcon /> Chat on WhatsApp
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: saturate(180%) blur(18px);
    -webkit-backdrop-filter: saturate(180%) blur(18px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, background 0.3s ease, backdrop-filter 0.3s ease;
  }
  .site-header.scrolled { border-bottom-color: var(--line); }
  /* Homepage: let the hero background show through at the top; the frosted
     translucent bar fades in once the page starts scrolling. */
  .site-header.is-overlay:not(.scrolled) {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .header-inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand { display: inline-flex; }
  .nav-desktop { display: flex; gap: 0.35rem; }
  .nav-link {
    position: relative;
    padding: 0.5rem 0.85rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-muted);
    border-radius: var(--r-sm);
    transition: color 0.2s ease, background 0.2s ease;
  }
  .nav-link:hover { color: var(--text); background: var(--bg-alt); }
  .nav-link.active { color: var(--text); }
  .nav-link.active::after {
    content: "";
    position: absolute;
    left: 0.85rem; right: 0.85rem; bottom: 2px;
    height: 2px;
    border-radius: 2px;
    background: var(--brand);
  }
  .header-actions { display: flex; align-items: center; gap: 0.75rem; }

  /* WhatsApp icon button (desktop) */
  .wa-btn {
    display: grid; place-items: center; width: 42px; height: 42px;
    border-radius: 12px; color: #25d366;
    background: rgba(37,211,102,0.1); border: 1px solid rgba(37,211,102,0.25);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .wa-btn:hover { background: #25d366; color: #fff; transform: translateY(-2px); box-shadow: 0 10px 24px -10px rgba(37,211,102,0.6); }
  .wa-btn :global(svg) { width: 21px; height: 21px; }

  /* WhatsApp full-width button (mobile menu) */
  .wa-btn-full {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    width: 100%; margin-top: 0.7rem; padding: 0.9rem 1.2rem;
    border-radius: var(--r-pill); font-weight: 600; font-size: 1rem;
    color: #06351a; background: #25d366;
    box-shadow: 0 12px 30px -14px rgba(37,211,102,0.6);
  }
  .wa-btn-full :global(svg) { width: 20px; height: 20px; }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px; height: 42px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
  }
  .nav-toggle span {
    display: block; height: 2px; width: 18px; margin-inline: auto;
    background: var(--ink); border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }
  .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-menu {
    border-top: 1px solid var(--line);
    background: var(--surface);
    padding: 1rem var(--gutter) 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu .btn { margin-top: 0.6rem; }
  .mobile-link {
    padding: 0.85rem 0.5rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text);
    border-bottom: 1px solid var(--line);
  }
  .mobile-link.active { color: var(--brand); }

  @media (max-width: 860px) {
    .nav-desktop { display: none; }
    .nav-toggle { display: flex; }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const onScroll = () => header?.classList.toggle("scrolled", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    if (menu) menu.hidden = open;
  });
</script>
