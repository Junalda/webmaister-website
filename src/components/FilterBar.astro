---
// Reusable client-side filter bar. Renders pill buttons and filters any
// elements on the page marked with data-filter-group="{scope}" and a
// data-filter-values attribute (pipe-separated, lowercased). Progressive
// enhancement: without JS every item stays visible.
interface Props {
  filters: { label: string; value: string }[];
  scope: string;
  allLabel?: string;
  label?: string;
}
const { filters, scope, allLabel = "All", label = "Filter" } = Astro.props;
---
<div class="filter-bar" role="group" aria-label={label} data-filter-scope={scope}>
  <button type="button" class="filter-pill is-active" data-filter="all" aria-pressed="true">{allLabel}</button>
  {filters.map((f) => (
    <button type="button" class="filter-pill" data-filter={f.value} aria-pressed="false">{f.label}</button>
  ))}
</div>

<style>
  .filter-bar {
    display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .filter-pill {
    font-size: 0.85rem; font-weight: 560; color: var(--text);
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-pill); padding: 0.45rem 1.05rem;
    cursor: pointer; transition: color .18s ease, background .18s ease, border-color .18s ease;
  }
  .filter-pill:hover { border-color: var(--accent); color: var(--brand-strong); }
  .filter-pill.is-active {
    color: #fff; background: var(--grad-brand); border-color: transparent;
  }
  .filter-pill:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".filter-bar").forEach((bar) => {
    const scope = bar.dataset.filterScope!;
    const items = Array.from(
      document.querySelectorAll<HTMLElement>(`[data-filter-group="${scope}"]`)
    );
    const pills = Array.from(bar.querySelectorAll<HTMLButtonElement>(".filter-pill"));
    const empty = document.querySelector<HTMLElement>(`[data-filter-empty="${scope}"]`);

    const apply = (val: string) => {
      let shown = 0;
      items.forEach((el) => {
        const vals = (el.dataset.filterValues || "").split("|");
        const match = val === "all" || vals.includes(val);
        el.hidden = !match;
        if (match) {
          el.classList.add("is-visible"); // safety: never leave a shown item faded out
          shown++;
        }
      });
      pills.forEach((p) => {
        const active = p.dataset.filter === val;
        p.classList.toggle("is-active", active);
        p.setAttribute("aria-pressed", String(active));
      });
      if (empty) empty.hidden = shown > 0;
      const url = new URL(location.href);
      if (val === "all") url.searchParams.delete(scope);
      else url.searchParams.set(scope, val);
      history.replaceState(null, "", url);
    };

    pills.forEach((p) => p.addEventListener("click", () => apply(p.dataset.filter!)));

    const init = new URL(location.href).searchParams.get(scope);
    if (init && pills.some((p) => p.dataset.filter === init)) apply(init);
  });
</script>
