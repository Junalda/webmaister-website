---
import Icon from "./Icon.astro";
interface Props {
  href: string;
  variant?: "primary" | "brand" | "ghost";
  size?: "md" | "lg";
  arrow?: boolean;
  class?: string;
}
const { href, variant = "primary", size = "md", arrow = false, class: className } = Astro.props;
const cls = ["btn", `btn-${variant}`, size === "lg" ? "btn-lg" : "", className ?? ""].join(" ").trim();
---
<a href={href} class={cls}>
  <slot />
  {arrow && <Icon name="arrow" class="arrow" />}
</a>

<style is:global>
  .btn .arrow { width: 18px; height: 18px; }
</style>
