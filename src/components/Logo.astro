---
// Webmaister wordmark = the "WM" monogram (blue→cyan gradient, matching the
// brand logo) + the wordmark text. Set `mono` to render the mark in a single
// light color for use on dark backgrounds (e.g. the footer).
interface Props {
  class?: string;
  mono?: boolean;
}
const { class: className, mono = false } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
const markPath = "M14 20 L34 80 L54 30 L74 80 L94 30 L114 80";
---
<span class={`logo ${className ?? ""}`} aria-label="Webmaister">
  <svg class="logo-mark" viewBox="0 0 128 100" role="img" aria-hidden="true">
    {!mono && (
      <defs>
        <linearGradient id={`g-${uid}`} x1="0" y1="0" x2="0" y2="100" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#0a8ef2" />
          <stop offset="1" stop-color="#06cfe8" />
        </linearGradient>
      </defs>
    )}
    <path
      d={markPath}
      fill="none"
      stroke={mono ? "#ffffff" : `url(#g-${uid})`}
      stroke-width="15"
      stroke-linejoin="miter"
      stroke-linecap="butt"
    />
  </svg>
  <span class="logo-word">Webmaister</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; font-weight: 650; letter-spacing: -0.02em; }
  .logo-mark { height: 26px; width: auto; flex-shrink: 0; }
  .logo-word { font-size: 1.18rem; }
</style>
