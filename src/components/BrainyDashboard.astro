---
// Conceptual "digital employee" dashboard — a premium, abstract product
// visual (no real data). Pure CSS/SVG so it stays fast and crisp.
import Icon from "./Icon.astro";
---
<div class="dash" data-reveal aria-hidden="true">
  <div class="dash-glow"></div>
  <div class="dash-window">
    <div class="dash-bar">
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
      <span class="dash-title">Brainy · Live workspace</span>
      <span class="dash-status"><span class="pulse"></span>Online · 24/7</span>
    </div>
    <div class="dash-body">
      <aside class="dash-side">
        <div class="side-item active"><Icon name="chat" /></div>
        <div class="side-item"><Icon name="users" /></div>
        <div class="side-item"><Icon name="calendar" /></div>
        <div class="side-item"><Icon name="chart" /></div>
        <div class="side-item"><Icon name="gear" /></div>
      </aside>
      <div class="dash-main">
        <div class="stat-row">
          <div class="stat"><span class="stat-k">Leads captured</span><span class="stat-v">128</span><span class="stat-d up">▲ 24%</span></div>
          <div class="stat"><span class="stat-k">Avg. response</span><span class="stat-v">12s</span><span class="stat-d up">▼ 4×</span></div>
          <div class="stat"><span class="stat-k">Auto-resolved</span><span class="stat-v">68%</span><span class="stat-d up">▲ 11%</span></div>
        </div>
        <div class="chat-card">
          <div class="msg in"><span>Hi! Do you build websites with AI booking?</span></div>
          <div class="msg out">
            <span>Absolutely — I can show examples and book your free strategy call now. What's your business?</span>
          </div>
          <div class="msg typing"><i></i><i></i><i></i></div>
        </div>
        <div class="task-row">
          <div class="task done"><Icon name="check" /> Qualified lead · routed to sales</div>
          <div class="task done"><Icon name="check" /> Follow-up email scheduled</div>
          <div class="task"><Icon name="clock" /> Booking confirmation pending</div>
        </div>
      </div>
    </div>
  </div>

  <div class="float float-1"><Icon name="bolt" /> <span>Lead qualified</span></div>
  <div class="float float-2"><Icon name="calendar" /> <span>Meeting booked</span></div>
</div>

<style>
  .dash { position: relative; padding: 14px; }
  .dash-glow {
    position: absolute; inset: -10% 0 0 0;
    background: var(--grad-brand);
    filter: blur(70px); opacity: 0.28; z-index: 0;
    border-radius: 50%;
  }
  .dash-window {
    position: relative; z-index: 1;
    background: #0e1018;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: 0 40px 80px -30px rgba(0,0,0,0.6);
  }
  .dash-bar {
    display: flex; align-items: center; gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.02);
  }
  .dot { width: 11px; height: 11px; border-radius: 50%; background: #2a2e3e; }
  .dot:first-child { background: #ff5f57; } .dot:nth-child(2){ background:#febc2e;} .dot:nth-child(3){background:#28c840;}
  .dash-title { margin-left: 10px; color: #aab0c4; font-size: 0.82rem; font-weight: 500; }
  .dash-status { margin-left: auto; display: flex; align-items: center; gap: 6px; color: #5fe3c0; font-size: 0.78rem; font-weight: 600; }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: #28c840; box-shadow: 0 0 0 0 rgba(40,200,64,0.6); animation: pulse 2s infinite; }
  @keyframes pulse { 0%{box-shadow:0 0 0 0 rgba(40,200,64,0.5);} 70%{box-shadow:0 0 0 8px rgba(40,200,64,0);} 100%{box-shadow:0 0 0 0 rgba(40,200,64,0);} }

  .dash-body { display: flex; min-height: 360px; }
  .dash-side {
    display: flex; flex-direction: column; gap: 10px;
    padding: 16px 12px; border-right: 1px solid rgba(255,255,255,0.06);
  }
  .side-item {
    width: 38px; height: 38px; border-radius: 11px;
    display: grid; place-items: center; color: #6b7286;
    background: rgba(255,255,255,0.03);
  }
  .side-item :global(svg) { width: 19px; height: 19px; }
  .side-item.active { color: #fff; background: var(--brand); box-shadow: var(--shadow-brand); }

  .dash-main { flex: 1; padding: 18px; display: flex; flex-direction: column; gap: 14px; }
  .stat-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .stat {
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
    border-radius: 14px; padding: 12px;
    display: flex; flex-direction: column; gap: 2px;
  }
  .stat-k { color: #8a90a3; font-size: 0.72rem; }
  .stat-v { color: #fff; font-size: 1.5rem; font-weight: 650; letter-spacing: -0.02em; }
  .stat-d { font-size: 0.72rem; font-weight: 600; }
  .stat-d.up { color: #5fe3c0; }

  .chat-card {
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
    border-radius: 14px; padding: 14px; display: flex; flex-direction: column; gap: 10px; flex: 1;
  }
  .msg { max-width: 82%; padding: 10px 13px; border-radius: 14px; font-size: 0.84rem; line-height: 1.45; }
  .msg.in { background: rgba(255,255,255,0.06); color: #d7dae6; border-bottom-left-radius: 4px; }
  .msg.out { align-self: flex-end; background: var(--brand); color: #fff; border-bottom-right-radius: 4px; }
  .msg.typing { display: inline-flex; gap: 4px; background: rgba(255,255,255,0.06); border-bottom-left-radius: 4px; }
  .msg.typing i { width: 6px; height: 6px; border-radius: 50%; background: #8a90a3; animation: blink 1.4s infinite both; }
  .msg.typing i:nth-child(2){ animation-delay: .2s; } .msg.typing i:nth-child(3){ animation-delay: .4s; }
  @keyframes blink { 0%,80%,100%{opacity:.2;transform:translateY(0);} 40%{opacity:1;transform:translateY(-2px);} }

  .task-row { display: flex; flex-direction: column; gap: 7px; }
  .task {
    display: flex; align-items: center; gap: 8px;
    font-size: 0.8rem; color: #aab0c4;
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
    border-radius: 11px; padding: 9px 12px;
  }
  .task :global(svg) { width: 15px; height: 15px; color: #6b7286; }
  .task.done { color: #d7dae6; } .task.done :global(svg) { color: #5fe3c0; }

  .float {
    position: absolute; z-index: 2;
    display: inline-flex; align-items: center; gap: 7px;
    padding: 9px 14px; border-radius: var(--r-pill);
    background: rgba(255,255,255,0.95); color: var(--ink);
    font-size: 0.82rem; font-weight: 600;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--line);
    animation: floaty 5s ease-in-out infinite;
  }
  .float :global(svg) { width: 16px; height: 16px; color: var(--brand); }
  .float-1 { top: 18%; right: -4%; animation-delay: 0s; }
  .float-2 { bottom: 14%; left: -5%; animation-delay: 1.5s; }
  @keyframes floaty { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-10px);} }

  @media (max-width: 560px) {
    .dash-side { display: none; }
    .stat-v { font-size: 1.2rem; }
    .float-1 { right: 0; } .float-2 { left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .float, .pulse, .msg.typing i { animation: none; }
  }
</style>
